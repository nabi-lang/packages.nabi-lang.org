// Page chrome (header, search, footer) and the generated pages: landing,
// package list, publishing guide, one page per package plus its tab pages.
// Every page is in English at `<page>` and in Korean at `ko/<page>`: the
// chrome, labels and dates in Korean, a package's own text as written.

use pkg::Site;
use pkg::docs::Status;
use pkg::meta;
use pkg::osv;
use pkg::packages;
use pkg::packages::{Package, Version};
use pkg::server::names;
use core::cmp::Ordering;
use markdown::{Options, esc};
use web::build;
use web::chrome;
use web::http;

/// The address of output file `out`, root-relative and canonical: no
/// `.html`, a directory index is the directory, no trailing slash
/// (`packages/index.html` -> `/packages`, `index.html` -> `/`).
pub fn url(out: str) -> str {
    let p = out.strip_suffix(".html") ?? out;
    if p == "index" { return "/"; }
    "/" + (p.strip_suffix("/index") ?? p)
}

pub fn package_out(name: str) -> str { f"packages/{name}.html" }

/// `en` or `kr`, by the page's language.
pub fn tr(ko: bool, en: str, kr: str) -> str { if ko { kr } else { en } }

/// Output file `out` in Korean when `ko`: `ko/<out>`.
pub fn in_lang(out: str, ko: bool) -> str { if ko { "ko/" + out } else { out } }

/// Whether output file `out` (or a path without its `/`) is a Korean page.
pub fn is_ko(out: str) -> bool { out == "ko" || out.starts_with("ko/") }

/// Root-relative path `p` on the Korean pages when `ko`: `/ko/packages`,
/// `/ko` for `/`. A query or fragment stays.
pub fn lp(ko: bool, p: str) -> str {
    if !ko { return p; }
    if p == "/" { return "/ko"; }
    if p.starts_with("/?") || p.starts_with("/#") { return "/ko" + p[1:]; }
    "/ko" + p
}

/// The publishing guide's section on publishing (its heading's id in
/// pages/publishing.md, pages/ko/publishing.md).
pub fn publishing_href(ko: bool) -> str { if ko { "/ko/publishing#패키지-공개" } else { "/publishing#publishing" } }

/// The address of output file `out` in Korean when `ko`.
pub fn href(ko: bool, out: str) -> str { url(in_lang(out, ko)) }

/// A package's tab page: `versions`, `dependencies` or `dependents`.
pub fn tab_out(name: str, tab: str) -> str { f"packages/{name}/{tab}.html" }

/// A version's page.
pub fn ver_out(name: str, v: str) -> str { f"packages/{name}/{v}.html" }

/// The docs of version `v` of package `name` (`latest`: its newest), on
/// the docs site, which renders them from what the registry made of that
/// version (GET /api/v1/packages/<name>/<v>/docs), as docs.rs does for
/// crates.io.
pub fn docs_url(site: Site, name: str, v: str) -> str { f"{site.docs}/packages/{name}/{v}" }

/// The readme page of `s`: the package's own, or the version's it shows.
fn readme_out(s: Package) -> str { if s.at.is_empty() { package_out(s.name) } else { ver_out(s.name, s.at) } }

/// `/name?v=<content version>` of a stylesheet or script (main.nabi
/// load_site); `serve` caches it for good at that version.
pub fn asset(site: Site, name: str) -> str {
    let v = asset_version(site, name);
    if v.is_empty() { "/" + name } else { f"/{name}?v={v}" }
}

/// The content version of asset `name`; `""` when it has none.
pub fn asset_version(site: Site, name: str) -> str {
    let k = site.assets.find("," + name + "=") ?? { return ""; };
    let rest = site.assets[k + name.len() + 2:];
    rest[:rest.find(",") ?? rest.len()]
}

/// Markdown options: `link` for hrefs, ```nabi / ```nabion highlighted.
pub fn md(link: fn(str) -> str) -> Options { Options { link: link, code: code_html } }

fn code_html(lang: str, body: str) -> (str | none) {
    if lang == "nabi" { return nabi_syntax::highlight_nabi(body); }
    if lang == "nabion" { return nabi_syntax::highlight_nabion(body); }
    none
}

fn short(rev: str) -> str { if rev.len() > 8 { rev[:8] } else { rev } }

fn plural(n: usize, one: str, many: str) -> str { if n == 1 { f"1 {one}" } else { f"{grouped(n)} {many}" } }

/// `plural`, or in Korean `<noun> <n>개`.
fn count_of(ko: bool, n: usize, one: str, many: str, noun: str) -> str { if ko { f"{noun} {grouped(n)}개" } else { plural(n, one, many) } }

/// `n` with thousands separators: `4812` -> `4,812`.
fn grouped(n: usize) -> str {
    let d = f"{n}";
    let out = StrBuf::new();
    let k = 0usize;
    for c in d.chars() {
        if k > 0 && (d.len() - k) % 3 == 0 { out.push(','); }
        out.push(c);
        k += 1;
    }
    out.to_str()
}

/// A byte count in KiB / MiB, one decimal below 100.
fn size(b: i64, ko: bool = false) -> str {
    let one = |x: i64, unit: str| {
        // x is tenths
        if x >= 1000i64 { f"{x / 10i64} {unit}" } else { f"{x / 10i64}.{x % 10i64} {unit}" }
    };
    if b < 1024i64 { return if ko { f"{b}바이트" } else { f"{b} bytes" }; }
    if b < 1048576i64 { return one((b * 10i64 + 512i64) / 1024i64, "KiB"); }
    one((b * 10i64 + 524288i64) / 1048576i64, "MiB")
}

// Package glyph: the name's first character in a tile, tinted by a hash
// of the name. Same hash as og/render.ts.

fn name_hash(name: str) -> i64 {
    let h = 7i64;
    for c in name.chars() { h = (h * 31i64 + ((c as u32) as i64)) % 9973i64; }
    h
}

/// The glyph, `px` square (`gl-<px>` in style.css); the colour comes
/// from its hue class (hue_class).
fn glyph(name: str, px: i32, cls: str) -> str {
    let first = name.chars().next() ?? '?';
    f"<span class=\"{cls} gl-{px} {hue_class(name)}\" aria-hidden=\"true\">{first}</span>"
}

/// `h0` .. `h35`: the package's hue in 10 degree steps, as a class that sets
/// `--h` (style.css). The CSP refuses style="".
pub fn hue_class(name: str) -> str { f"h{name_hash(name) % 360i64 / 10i64}" }

fn icon_search() -> str {
    "<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"M20 20l-4-4\"/></svg>"
}

fn search_box(ko: bool) -> str {
    let (find, results) = if ko { ("패키지 검색", "검색 결과") } else { ("Search packages", "Search results") };
    f"<form class=\"search\" role=\"search\" action=\"{lp(ko, "/packages")}\">{icon_search()}<input class=\"q\" name=\"q\" type=\"search\" placeholder=\"{find}\" aria-label=\"{find}\" aria-keyshortcuts=\"/ Control+K Meta+K\" autocomplete=\"off\" spellcheck=\"false\" role=\"combobox\" aria-autocomplete=\"list\" aria-expanded=\"false\" aria-controls=\"results\"><kbd class=\"kbd\" aria-hidden=\"true\">/</kbd><ul id=\"results\" class=\"results appear\" role=\"listbox\" aria-label=\"{results}\" hidden></ul><p class=\"sr-only\" role=\"status\"></p></form>"
}

/// The slogan, in Korean as nabi-lang.org/ko has it.
pub const TAGLINE: str = "Clear rules, free as a butterfly.";
pub const TAGLINE_KO: str = "규칙은 분명하게, 나비처럼 자유롭게.";

/// The footer every Nabi site shares (chrome::site_cols, legal links in
/// its bar).
fn footer(site: Site, ko: bool) -> str {
    let l = chrome::Links { home: site.home + "/", docs: site.docs + "/latest/", docs_host: site.docs + "/", registry: lp(ko, "/"), playground: site.playground + "/" };
    let home = site.home + (if ko { "/ko" } else { "" });
    chrome::footer(chrome::Footer {
        home: home,
        logo: "/logo.svg",
        tagline: tr(ko, TAGLINE, TAGLINE_KO),
        cols: chrome::site_cols(l, ko),
        sites: chrome::Sites { home: home, docs: site.docs + (if ko { "/latest/ko" } else { "/latest" }), registry: lp(ko, "/"), playground: site.playground + (if ko { "/ko" } else { "" }), current: "registry" },
        release: site.release,
        ko: ko,
    })
}

/// Every page is built logged out; `serve` swaps this for the account
/// menu (signed_in) on a request with a live session.
pub const LOGIN_BUTTON: str = "<a class=\"btn-2 btn-sm login\" href=\"/login\">Log in<span class=\"wide\"> with GitHub</span></a>";

/// LOGIN_BUTTON of the Korean pages: back to the Korean account page.
pub const LOGIN_BUTTON_KO: str = "<a class=\"btn-2 btn-sm login\" href=\"/ko/login\"><span class=\"wide\">GitHub로 </span>로그인</a>";

/// `html` with the login button replaced by account `login`'s menu: its
/// avatar and login, the account page, and a log-out form carrying the
/// session's `csrf`. A `<details>`, so it needs no script.
pub fn signed_in(html: str, login: str, id: i64, csrf: str) -> str {
    let ko = html.contains(LOGIN_BUTTON_KO);
    let (label, who, account, out) = if ko { (f"{esc(login)} 계정 메뉴", f"로그인 계정 <strong>{esc(login)}</strong>", "계정", "로그아웃") } else { (f"Account menu of {esc(login)}", f"Logged in as <strong>{esc(login)}</strong>", "Account", "Log out") };
    let menu = f"<details class=\"user\"><summary class=\"btn-2 btn-sm\" aria-label=\"{label}\">{avatar(id, 20, false)}<span class=\"wide\">{esc(login)}</span></summary><div class=\"user-menu\"><p class=\"t-small\">{who}</p><a href=\"{lp(ko, "/me")}\">{account}</a><form method=\"post\" action=\"{lp(ko, "/logout")}\"><input type=\"hidden\" name=\"csrf\" value=\"{esc(csrf)}\"><button type=\"submit\">{out}</button></form></div></details>";
    html.replace(if ko { LOGIN_BUTTON_KO } else { LOGIN_BUTTON }, menu)
}

/// GitHub's avatar of `id`, `px` square (drawn at twice that); "" when the
/// id is not known. An organisation's has rounded corners, a user's is round.
pub fn avatar(id: i64, px: i32, org: bool) -> str {
    let src = meta::avatar_url(id, px * 2);
    if src.is_empty() { return ""; }
    f"<img class=\"av{if org { " org" } else { "" }}\" src=\"{src}\" width=\"{px}\" height=\"{px}\" alt=\"\" loading=\"lazy\" decoding=\"async\">"
}

/// `p`'s GitHub page: a user's or organisation's profile, a team's page.
pub fn github_page(login: str) -> str {
    if let (org, team) = login.split_once("/") ?? ("", "") {
        if !org.is_empty() { return f"https://github.com/orgs/{http::pct_encode(org)}/teams/{http::pct_encode(team)}"; }
    }
    f"https://github.com/{http::pct_encode(login)}"
}

/// `p` with its avatar, linked to GitHub: the display name when it has
/// one (the login as the tooltip), else the login.
pub fn person_link(p: meta::Person, px: i32) -> str {
    let tip = if p.name.is_empty() { "" } else { f" title=\"{esc(p.login)}\"" };
    let text = if p.name.is_empty() { p.login } else { p.name };
    f"<a class=\"who\" href=\"{esc(github_page(p.login))}\"{tip}>{avatar(p.id, px, p.org || p.login.contains("/"))}<span>{esc(text)}</span></a>"
}

/// `page` with a `<meta name="description">` of its own.
pub fn page(site: Site, out: str, title: str, body: str) -> str { page_desc(site, out, title, "", body) }

/// The page of output file `out` (`ko/..` is Korean: the chrome, `lang`
/// and the description, which `about` gives as it is). `img` and `alt`
/// are a package's card; the home card by default. Every card is drawn
/// at the home card's size (og/render.ts). `ld` is its JSON-LD, `query`
/// a search the language menu keeps.
pub fn page_desc(site: Site, out: str, title: str, about: str, body: str, img: str = "", alt: str = "", ld: str = "", query: str = "") -> str {
    let ko = is_ko(out);
    let at = if out == "ko" { "index.html" } else if ko { out[3:] } else { out };
    let home = at == "index.html";
    let name = tr(ko, site.title, "Nabi 패키지");
    let full = if home { name + " - " + tr(ko, site.tagline, "Nabi 패키지 레지스트리") } else { title + " - " + name };
    let desc = esc(if !about.is_empty() { build::clip(about, 160) } else if ko { "Nabi 패키지 레지스트리입니다. 패키지를 찾은 뒤 nabi add <이름>으로 추가합니다." } else { site.description });
    let canon = site.base_url + url(out);
    // The same page in each language; search engines get both, English
    // as the default.
    let q = if query.is_empty() { "" } else { "?" + query };
    let en_url = url(at);
    let ko_url = url("ko/" + at);
    let alts = f"<link rel=\"alternate\" hreflang=\"en\" href=\"{esc(site.base_url + en_url)}\">\n<link rel=\"alternate\" hreflang=\"ko\" href=\"{esc(site.base_url + ko_url)}\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"{esc(site.base_url + en_url)}\">\n";
    let langs = chrome::lang_menu(ko, [chrome::Lang { code: "en", name: "English", href: if ko { en_url + q } else { "" } }, chrome::Lang { code: "ko", name: "한국어", href: if ko { "" } else { ko_url + q } }]);
    // Heading permalinks are aria-hidden, so keep them out of the tab order too.
    let body = body.replace("class=\"anchor\" href=", "class=\"anchor\" tabindex=\"-1\" href=");
    let (ogimg, ogalt) = if img.is_empty() { (site.base_url + "/og.png" + (if site.og.is_empty() { "" } else { "?v=" + site.og }), f"{site.title}: {site.tagline}") } else { (img, alt) };
    let cur = |on: bool| if on { " aria-current=\"page\"" } else { "" };
    let browse = cur(at.starts_with("packages/") || at.starts_with("categories/") || at.starts_with("keywords/"));
    let publish = cur(at == "publishing.html" || at == "api.html");
    let docs = site.docs + tr(ko, "/latest", "/latest/ko");
    let nav = f"<a href=\"{esc(site.home + tr(ko, "", "/ko"))}\" title=\"nabi-lang.org\">{tr(ko, "Home", "홈")}</a><a href=\"{lp(ko, "/packages")}\"{browse}>{tr(ko, "Browse", "둘러보기")}</a><a href=\"{lp(ko, "/publishing")}\"{publish}>{tr(ko, "Publishing", "패키지 공개")}</a><a href=\"{esc(docs)}\" title=\"{tr(ko, "The guide, the language reference and the standard library, on docs.nabi-lang.org", "가이드, 언어 사양, 표준 라이브러리: docs.nabi-lang.org")}\">{tr(ko, "Nabi docs", "Nabi 문서")}</a><a href=\"{esc(site.playground + tr(ko, "", "/ko"))}\">{tr(ko, "Playground", "플레이그라운드")}</a>";
    f"<!doctype html>
<html lang=\"{tr(ko, "en", "ko")}\" class=\"nb lt\">
<head>
{chrome::head(chrome::Head { title: full, site: name, desc: desc, url: canon, img: ogimg, img_w: site.og_w, img_h: site.og_h, alt: ogalt, asset: |n| asset(site, n), extra: alts, ko: ko })}{ld}</head>
<body>
<a class=\"skip\" href=\"#content\">{tr(ko, "Skip to content", "본문으로 건너뛰기")}</a>
<header class=\"hdr\">
<div class=\"frame in\">
<a class=\"brand\" href=\"{lp(ko, "/")}\" lang=\"en\">{web::chrome::wordmark("Nabi")}<span class=\"sl\" aria-hidden=\"true\">/</span><span class=\"site\">packages</span></a>
{search_box(ko)}
<nav id=\"nav\" class=\"nav\" aria-label=\"{tr(ko, "Registry", "레지스트리")}\">{nav}</nav>
{langs}
{chrome::theme_button(ko)}
{if ko { LOGIN_BUTTON_KO } else { LOGIN_BUTTON }}
<button class=\"ib menu\" type=\"button\" aria-label=\"{tr(ko, "Menu", "메뉴")}\" aria-expanded=\"false\" aria-controls=\"nav\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M4 7h16M4 12h16M4 17h16\"/></svg></button>
</div>
</header>
<main id=\"content\">
{body}
</main>
{footer(site, ko)}<script src=\"{asset(site, "keys.js")}\" defer></script>
<script src=\"{asset(site, "copy.js")}\" defer></script>
<script src=\"{asset(site, "search.js")}\" defer></script>
</body>
</html>
"
}

/// A package as the lists and search show it. main.nabi writes every one
/// to `public/.packages.nabion` (dot files are never served), which `serve`
/// searches and checks package addresses against.
#[derive(Nabion)]
pub struct Row {
    pub name: str;
    pub version: str;
    pub desc: str;
    pub keywords: List<str>;
    pub yanked: bool;
    /// Last index commit touching it: unix time and `YYYY-MM-DD`.
    pub time: i64;
    pub date: str;
    pub official: bool = false;
    /// A standard library tier: no versions, it ships with the toolchain.
    pub library: bool = false;
    /// It has an executable (`nabi install`), and a library.
    pub bin: bool = false;
    pub lib: bool = true;
}

pub fn row_of(s: Package) -> Row {
    Row { name: s.name, version: s.latest.version, desc: s.desc, keywords: s.meta.keywords, yanked: s.latest.yanked, time: s.time, date: s.date, official: s.official, library: s.library, bin: packages::has_bin(s), lib: s.has_lib }
}

/// The mark of a package with an executable, in lists and search.
pub fn bin_tag(ko: bool = false) -> str { f"<span class=\"tag bin\" title=\"{tr(ko, "Has an executable: nabi install installs it", "실행 파일이 있습니다. nabi install로 설치합니다")}\">bin</span>" }

/// What a list shows in place of a standard library tier's version.
const WITH_TOOLCHAIN: str = "with nabi";
const WITH_TOOLCHAIN_KO: str = "nabi에 포함";

fn with_toolchain(ko: bool) -> str { if ko { WITH_TOOLCHAIN_KO } else { WITH_TOOLCHAIN } }

/// A standard library tier's description in Korean (packages::
/// library_desc has the English, which the site writes, not a package).
pub fn library_desc_ko(name: str) -> str {
    match name {
        "bare" => "표준 라이브러리의 가장 낮은 층: 포인터, 메모리, FFI. 도구 모음에 함께 들어 있습니다.",
        "core" => "모든 대상에 있는 표준 라이브러리 층: 컬렉션, 수, 반복자, 서식, 태스크. 도구 모음에 함께 들어 있습니다.",
        _ => "호스트 대상의 표준 라이브러리 층: 파일, 네트워크, 시간, 스레드, 프로세스. 도구 모음에 함께 들어 있습니다.",
    }
}

/// `desc` of a package as a page in `ko` shows it: as written, but the
/// site's own text of a standard library tier in Korean.
fn desc_in(name: str, desc: str, library: bool, ko: bool) -> str { if library && ko { library_desc_ko(name) } else { desc } }

/// A yanked version's tag.
fn yanked_tag(ko: bool) -> str { tr(ko, "yanked", "철회됨") }

/// The mark of an official package: a word, not only a colour, so screen
/// readers and high-contrast modes read it too.
pub fn official_badge(ko: bool = false) -> str {
    f"<span class=\"official\" title=\"{tr(ko, "Published from the nabi-lang organization", "nabi-lang 조직에서 공개했습니다")}\"><svg aria-hidden=\"true\" viewBox=\"0 0 16 16\" width=\"12\" height=\"12\"><path d=\"M3.5 8.5l3 3 6-7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>{tr(ko, "Official", "공식")}</span>"
}

/// A search result: how well it matched and where.
pub struct Hit {
    pub row: Row;
    pub rank: i32;
    pub why: str;
}

/// The words of a query, lowercase, without its filters (filter_of).
pub fn terms_of(q: str) -> List<str> {
    let out: List<str> = List::new();
    for w in q.to_lowercase().replace("\t", " ").split(" ") {
        if !w.is_empty() && !w.starts_with("official:") { out.push(w); }
    }
    out
}

/// The query's `official:yes` / `official:no` filter: `"yes"`, `"no"`, or
/// `""` for none (the last one wins).
pub fn filter_of(q: str) -> str {
    let f = "";
    for w in q.to_lowercase().replace("\t", " ").split(" ") {
        if let v: str = w.strip_prefix("official:") {
            f = if v == "yes" || v == "true" { "yes" } else if v == "no" || v == "false" { "no" } else { f };
        }
    }
    f
}

/// The rows with every term of `q` in the name, description or a keyword
/// (all rows for an empty `q`) that pass its `official:` filter, ordered
/// by `sort`: `relevance` (exact name, name prefix, name, keyword, the
/// rest; official packages first within each; then by name), `name` or
/// `updated` (newest first). search.js matches the same way.
pub fn search(rows: List<Row>, q: str, sort: str) -> List<Hit> {
    let terms = terms_of(q);
    let only = filter_of(q);
    let whole = terms.join(" ");
    let hits: List<Hit> = List::new();
    for r in rows {
        if (only == "yes" && !r.official) || (only == "no" && r.official) { continue; }
        let t = r.name.to_lowercase();
        let p = r.desc.to_lowercase();
        let ks: List<str> = List::new();
        for k in r.keywords { ks.push(k.to_lowercase()); }
        let in_kw = |w: str| {
            for k in ks {
                if k.contains(w) { return true; }
            }
            false
        };
        let all = true;
        let n = false;
        let d = false;
        let kw = false;
        for w in terms {
            let a = t.contains(w);
            let b = p.contains(w);
            let c = in_kw(w);
            if !a && !b && !c { all = false; }
            n = n || a;
            d = d || b;
            kw = kw || c;
        }
        if !all { continue; }
        let wheres: List<str> = List::new();
        if n { wheres.push("name"); }
        if d { wheres.push("description"); }
        if kw { wheres.push("keywords"); }
        // why_text puts these in words.
        let rank = if terms.is_empty() { 0 } else if t == whole { 0 } else if t.starts_with(whole) { 1 } else if t.contains(whole) { 2 } else if ks.contains(whole) { 3 } else { 4 };
        hits.push(Hit { row: r, rank: rank, why: if wheres.len() == 3 { "name, description and keywords" } else { wheres.join(" and ") } });
    }
    if sort == "updated" {
        hits.sort_by(|a: Hit, b: Hit| if a.row.time != b.row.time { b.row.time.cmp(a.row.time) } else { a.row.name.cmp(b.row.name) });
    } else if sort == "name" {
        hits.sort_by(|a: Hit, b: Hit| a.row.name.cmp(b.row.name));
    } else {
        hits.sort_by(|a: Hit, b: Hit| if a.rank != b.rank { a.rank.cmp(b.rank) } else if a.row.official != b.row.official { b.row.official.cmp(a.row.official) } else { a.row.name.cmp(b.row.name) });
    }
    hits
}

/// Where a search matched (Hit.why), in the page's language.
fn why_text(why: str, ko: bool) -> str {
    if !ko { return why; }
    let w = why.replace("name", "이름").replace("description", "설명").replace("keywords", "키워드");
    w.replace(" and ", ", ")
}

/// `text` escaped, each term wrapped in `<mark>`. Non-ASCII text is left
/// unmarked: its lowercase may not line up byte for byte.
fn marked(text: str, terms: List<str>) -> str {
    if terms.is_empty() { return esc(text); }
    for c in text.chars() {
        if !c.is_ascii() { return esc(text); }
    }
    let lo = text.to_lowercase();
    let out = StrBuf::new();
    let i = 0usize;
    while i < text.len() {
        let best = text.len();
        let len = 0usize;
        for w in terms {
            if let k: usize = lo[i:].find(w) {
                if i + k < best || (i + k == best && w.len() > len) {
                    best = i + k;
                    len = w.len();
                }
            }
        }
        out.push_str(esc(text[i:best]));
        if best == text.len() { break; }
        out.push_str(f"<mark>{esc(text[best:best + len])}</mark>");
        i = best + len;
    }
    out.to_str()
}

/// `<li>` of a package in a list; `note` replaces the date, `terms` are
/// marked and `why` says where they matched.
fn package_row(s: Row, note: str, ko: bool, terms: List<str> = List::new(), why: str = "") -> str {
    let href = esc(href(ko, package_out(s.name)));
    let desc = if s.desc.is_empty() { f"<span class=\"desc none\">{tr(ko, "No description", "설명 없음")}</span>" } else { f"<span class=\"desc\">{marked(desc_in(s.name, s.desc, s.library, ko), terms)}</span>" };
    let gone = (if s.official { official_badge(ko) } else { "" }) + (if s.bin { bin_tag(ko) } else { "" }) + (if s.yanked { f" <span class=\"tag\">{yanked_tag(ko)}</span>" } else { "" });
    let matched = if why.is_empty() { "" } else if ko { f"<span class=\"why\">{why_text(why, true)}에서 일치</span>" } else { f"<span class=\"why\">matches {why}</span>" };
    let when = if !note.is_empty() { f"<span class=\"when\">{note}</span>" } else if s.date.is_empty() { "<span class=\"when\"></span>" } else { when_tag(s.date, "when", true) };
    f"<li{if s.yanked { " class=\"yanked\"" } else { "" }}><a class=\"st\" href=\"{href}\">{glyph(s.name, 34, "gl")}<span class=\"main\"><span class=\"nl\"><b class=\"nm\">{marked(s.name, terms)}</b>{gone}{matched}</span>{desc}</span><span class=\"ver\">{esc(if s.library { with_toolchain(ko) } else { s.version })}</span>{when}</a></li>"
}

fn package_rows(xs: List<Package>, empty: str, ko: bool, dependents: bool = false) -> str {
    if xs.len() == 0 { return f"<p class=\"empty\">{esc(empty)}</p>"; }
    let b = StrBuf::new();
    b.push_str("<ul class=\"rows\">");
    for s in xs { b.push_str(package_row(row_of(s), if dependents { count_of(ko, s.rdeps.len(), "dependent", "dependents", "의존하는 패키지") } else { "" }, ko)); }
    b.push_str("</ul>");
    b.to_str()
}

pub fn landing(all: List<Package>, ko: bool) -> str {
    let nv = 0usize;
    for s in all { nv += s.versions.len(); }

    let recent: List<Package> = List::new();
    for s in all { recent.push(s); }
    recent.sort_by(|a: Package, b: Package| if a.time != b.time { b.time.cmp(a.time) } else { a.name.cmp(b.name) });
    let rs: List<Package> = List::new();
    for s in recent {
        if rs.len() == 10 { break; }
        rs.push(s);
    }
    let popular: List<Package> = List::new();
    for s in all {
        if s.rdeps.len() > 0 { popular.push(s); }
    }
    popular.sort_by(|a: Package, b: Package| if a.rdeps.len() != b.rdeps.len() { b.rdeps.len().cmp(a.rdeps.len()) } else { a.name.cmp(b.name) });
    let ps: List<Package> = List::new();
    for s in popular {
        if ps.len() == 5 { break; }
        ps.push(s);
    }
    // Only once some package has dependents: an empty list says nothing.
    let most = if ps.is_empty() {
        ""
    } else {
        f"<section aria-labelledby=\"most\" class=\"block\"><div class=\"list-head\"><h2 class=\"t-h3\" id=\"most\">{tr(ko, "Most depended on", "의존이 가장 많은 패키지")}</h2></div>{package_rows(ps, "", ko, true)}</section>"
    };
    let official: List<Package> = List::new();
    for s in all {
        if s.official { official.push(s); }
    }
    let off = if official.is_empty() {
        ""
    } else {
        f"<section aria-labelledby=\"official\" class=\"block\"><div class=\"list-head\"><h2 class=\"t-h3\" id=\"official\">{tr(ko, "Official packages", "공식 패키지")}</h2><span class=\"t-small\">{tr(ko, "Published from the nabi-lang organization", "nabi-lang 조직에서 공개")} · <a href=\"{lp(ko, "/packages?q=official:yes")}\">{tr(ko, "see all", "모두 보기")}</a></span></div>
{official_groups(official, ko)}</section>"
    };
    // The biggest categories, for browsing.
    let cats = topics(all, true);
    cats.sort_by(|a: Topic, b: Topic| if a.packages.len() != b.packages.len() { b.packages.len().cmp(a.packages.len()) } else { a.slug.cmp(b.slug) });
    let cb = StrBuf::new();
    for k in 0..cats.len().min(8) { cb.push_str(f"<li><a href=\"{esc(href(ko, topic_out(true, cats[k].slug)))}\">{esc(cats[k].label)}</a><span class=\"ct\">{grouped(cats[k].packages.len())}</span></li>"); }
    let browse = if cats.is_empty() { "" } else { f"<section><h2 class=\"t-h3\">{tr(ko, "Browse by category", "카테고리별로 둘러보기")}</h2><ul class=\"topics compact\">{cb.to_str()}</ul><p><a href=\"{lp(ko, "/categories")}\">{tr(ko, "All categories", "모든 카테고리")}</a> · <a href=\"{lp(ko, "/keywords")}\">{tr(ko, "keywords", "키워드")}</a></p></section>\n" };
    let example = if all.is_empty() { "json" } else { recent[0].name };
    let example_official = !all.is_empty() && recent[0].official;
    for s in all {
        if s.name == "json" { example = "json"; example_official = s.official; }
    }
    // An official package comes in on `use`; `nabi add` stays the explicit way.
    let use_line = f"<code class=\"ic\">use {esc(example)}::..;</code>";
    let use_note = if example_official {
        tr(ko, f"<p>Write {use_line} in your code: an official package is added on the first build. To add one yourself, run this in a package directory.</p>", f"<p>코드에 {use_line} 한 줄만 쓰면, 공식 패키지는 첫 빌드에서 추가됩니다. 직접 추가하려면 패키지 디렉터리에서 다음을 실행합니다.</p>")
    } else {
        tr(ko, f"<p>Run this in a package directory, then {use_line} in your code.</p>", f"<p>패키지 디렉터리에서 다음을 실행한 뒤, 코드에 {use_line} 줄을 씁니다.</p>")
    };
    let add = f"<code class=\"ic\">nabi add {esc(example)}</code>";
    let lead = tr(ko, f"packages.nabi-lang.org is the Nabi package registry. Add a package with {add}; the build pins its exact version in <code class=\"ic\">nabi.lock</code>.", f"packages.nabi-lang.org는 Nabi 패키지 레지스트리입니다. {add}로 패키지를 추가하면, 빌드가 정확한 버전을 <code class=\"ic\">nabi.lock</code>에 고정합니다.");
    let counts = if ko { f"패키지 {grouped(all.len())}개, 버전 {grouped(nv)}개" } else { f"{plural(all.len(), "package", "packages")}, {plural(nv, "version", "versions")}" };
    let publishing = tr(ko, "<p>Packages are published here with <code class=\"ic\">nabi publish</code>, or from GitHub Actions with trusted publishing. Publishing is not open to everyone yet.</p>", "<p>패키지는 <code class=\"ic\">nabi publish</code>로, 또는 GitHub Actions에서 신뢰할 수 있는 게시(trusted publishing)로 공개합니다. 아직 누구나 공개할 수 있지는 않습니다.</p>");

    f"<section class=\"frame intro\">
<h1 class=\"t-h1\">{tr(ko, "Packages for Nabi", "Nabi 패키지")}</h1>
<p class=\"t-lead\">{lead}</p>
</section>
<div class=\"frame home\">
<div>
{off}<section aria-labelledby=\"recent\" class=\"block\"><div class=\"list-head\"><h2 class=\"t-h3\" id=\"recent\">{tr(ko, "Recently updated", "최근 업데이트")}</h2><span class=\"t-small\">{counts} · <a href=\"{lp(ko, "/packages")}\">{tr(ko, "see all", "모두 보기")}</a></span></div>
{package_rows(rs, tr(ko, "No packages published yet.", "아직 공개된 패키지가 없습니다."), ko)}</section>
{most}</div>
<aside class=\"side-notes\">
<section><h2 class=\"t-h3\">{tr(ko, "Using a package", "패키지 사용하기")}</h2>
{use_note}
<div class=\"inst\"><div class=\"ipanel on\"><pre class=\"sh\"><code><span class=\"p\" aria-hidden=\"true\">$ </span>nabi add {esc(example)}</code></pre>{chrome::copy_button("nabi add " + example, ko)}</div></div></section>
{browse}<section><h2 class=\"t-h3\">{tr(ko, "Publishing", "패키지 공개")}</h2>
{publishing}
<p><a href=\"{publishing_href(ko)}\">{tr(ko, "How publishing works", "공개하는 방법")}</a></p></section>
</aside>
</div>
"
}

/// Whether `s` is for science and data: its categories say so.
fn is_science(s: Package) -> bool {
    for c in s.meta.categories {
        if c == "science" || c == "mathematics" { return true; }
    }
    false
}

/// The official packages by shelf: the standard library, science and
/// data, then the rest; a shelf with nothing on it is left out.
fn official_groups(xs: List<Package>, ko: bool) -> str {
    let lib: List<Package> = List::new();
    let sci: List<Package> = List::new();
    let rest: List<Package> = List::new();
    for s in xs {
        if s.library { lib.push(s); } else if is_science(s) { sci.push(s); } else { rest.push(s); }
    }
    let b = StrBuf::new();
    for (id, title, ps) in [("off-lib", tr(ko, "Standard library, with every toolchain", "표준 라이브러리, 모든 도구 모음에 포함"), lib), ("off-sci", tr(ko, "Science and data", "과학과 데이터"), sci), ("off-gen", tr(ko, "Formats, text and networking", "데이터 형식, 텍스트, 네트워킹"), rest)] {
        if ps.is_empty() { continue; }
        b.push_str(f"<div class=\"off-shelf\" role=\"group\" aria-labelledby=\"{id}\"><h3 class=\"t-label\" id=\"{id}\">{title}</h3>{official_grid(ps, ko)}</div>");
    }
    b.to_str()
}

/// The official packages, compact: name, version and description each.
fn official_grid(xs: List<Package>, ko: bool) -> str {
    let b = StrBuf::new();
    b.push_str("<ul class=\"off-grid\">");
    for s in xs {
        let desc = if s.desc.is_empty() { "" } else { f"<span class=\"desc\">{esc(desc_in(s.name, s.desc, s.library, ko))}</span>" };
        b.push_str(f"<li><a href=\"{esc(href(ko, package_out(s.name)))}\"><span class=\"nl\"><b class=\"nm\">{esc(s.name)}</b><span class=\"ver\">{esc(if s.library { with_toolchain(ko) } else { s.latest.version })}</span></span>{desc}</a></li>");
    }
    b.push_str("</ul>");
    b.to_str()
}

/// Edits a misspelt term of `n` characters may be from the word it
/// meant: none under 3 characters, then 1, 2 from 5, 3 from 9.
pub fn typo_room(n: usize) -> usize { if n < 3 { 0usize } else if n <= 4 { 1usize } else if n <= 8 { 2usize } else { 3usize } }

/// `q` with each term that is in no name, description or keyword
/// replaced by the nearest name, part of a name (split at `-` / `_`) or
/// keyword within typo_room edits (names::edits); names win ties, then
/// the shorter distance, then the word. None when no term changed.
/// search.tsx corrects the same way.
pub fn corrected(rows: List<Row>, q: str) -> str | none {
    let words: List<(str, bool)> = List::new();
    let seen: Set<str> = Set::new();
    let add = |w: str, name: bool| {
        if w.char_count() >= 2 && !seen.contains(w) {
            seen.insert(w);
            words.push((w, name));
        }
    };
    for r in rows {
        let n = r.name.to_lowercase();
        add(n, true);
        for part in n.replace("_", "-").split("-") { add(part, true); }
    }
    for r in rows {
        for k in r.keywords {
            let kl = k.to_lowercase();
            add(kl, false);
            for part in kl.replace("_", "-").split("-") { add(part, false); }
        }
    }
    let found = |w: str| {
        for r in rows {
            if r.name.to_lowercase().contains(w) || r.desc.to_lowercase().contains(w) { return true; }
            for k in r.keywords {
                if k.to_lowercase().contains(w) { return true; }
            }
        }
        false
    };
    let out: List<str> = List::new();
    let changed = false;
    for w in q.to_lowercase().replace("\t", " ").split(" ") {
        if w.is_empty() { continue; }
        let room = typo_room(w.char_count());
        if w.starts_with("official:") || room == 0 || found(w) {
            out.push(w);
            continue;
        }
        let best = "";
        let best_d = room + 1;
        let best_name = false;
        for (c, name) in words {
            let d = names::edits(w, c);
            if d > room { continue; }
            let better = d < best_d || (d == best_d && ((name && !best_name) || (name == best_name && c < best)));
            if better {
                best = c;
                best_d = d;
                best_name = name;
            }
        }
        if best.is_empty() {
            out.push(w);
        } else {
            out.push(best);
            changed = true;
        }
    }
    if changed { out.join(" ") } else { none }
}

/// Up to three of `names` close to `name`: a few edits away, or one
/// containing the other; nearest first.
pub fn closest(names: List<str>, name: str) -> List<str> {
    let q = name.to_lowercase();
    let n = q.char_count();
    let room = if n <= 3 { 1usize } else if n <= 6 { 2usize } else { 3usize };
    let near: List<(usize, str)> = List::new();
    for c in names {
        let d = names::edits(q, c);
        if d <= room || (n >= 3 && (c.contains(q) || q.contains(c))) { near.push((d, c)); }
    }
    near.sort_by(|a: (usize, str), b: (usize, str)| if a.0 != b.0 { a.0.cmp(b.0) } else { a.1.cmp(b.1) });
    let out: List<str> = List::new();
    for (_d, c) in near {
        if out.len() == 3 { break; }
        out.push(c);
    }
    out
}

/// The sorts the package list offers: value, label.
const SORTS: [(str, str, str); 3] = [("relevance", "Relevance", "관련도"), ("name", "Name", "이름"), ("updated", "Recently updated", "최근 업데이트")];

/// The package list, `/packages`: every package, or those matching `q`, in
/// `sort` order. The page title and the body.
pub fn list_page(rows: List<Row>, q: str, sort: str, ko: bool = false) -> (str, str) {
    let q = q.trim();
    let terms = terms_of(q);
    let only = filter_of(q);
    // Without a query every row ties on relevance: that is name order.
    let sort = if sort == "name" || sort == "updated" { sort } else if terms.is_empty() { "name" } else { "relevance" };
    let hits = search(rows, q, sort);
    // Nothing matched: a misspelling, most likely. Show the corrected
    // query's matches and say so.
    let fixed = "";
    if hits.is_empty() && !terms.is_empty() {
        if let c: str = corrected(rows, q) {
            let again = search(rows, c, sort);
            if !again.is_empty() {
                fixed = c;
                hits = again;
                terms = terms_of(c);
            }
        }
    }
    let order = if sort == "updated" { tr(ko, "recently updated first", "최근 업데이트 순") } else if sort == "name" { tr(ko, "sorted by name", "이름 순") } else { tr(ko, "best match first", "관련도 순") };
    let opts = StrBuf::new();
    for (v, label, label_ko) in SORTS {
        if v == "relevance" && terms.is_empty() { continue; }
        opts.push_str(f"<option value=\"{v}\"{if v == sort { " selected" } else { "" }}>{tr(ko, label, label_ko)}</option>");
    }
    let list_url = lp(ko, "/packages");
    let find = tr(ko, "Search packages", "패키지 검색");
    let form = f"<form class=\"list-form\" role=\"search\" action=\"{list_url}\"><label class=\"sr-only\" for=\"list-q\">{find}</label><input id=\"list-q\" class=\"field\" name=\"q\" type=\"search\" value=\"{esc(q)}\" placeholder=\"{find}\" autocomplete=\"off\" spellcheck=\"false\"><label class=\"t-ui\" for=\"list-sort\">{tr(ko, "Sort", "정렬")}</label><select id=\"list-sort\" class=\"field\" name=\"sort\">{opts.to_str()}</select><button class=\"btn-2 btn-sm\" type=\"submit\">{tr(ko, "Search", "검색")}</button></form>";
    let qt = f"<q>{esc(q)}</q>";
    let all_link = f"<a href=\"{list_url}\">{tr(ko, "Show all packages", "모든 패키지 보기")}</a>";
    let search_title = tr(ko, f"Search: {q}", f"검색: {q}");
    let (title, note) = if terms.is_empty() && only == "yes" {
        (tr(ko, "Official packages", "공식 패키지"), if ko { f"공식 패키지 {grouped(hits.len())}개, {order}. 공식 패키지는 nabi-lang 조직에서 공개합니다." } else { f"{plural(hits.len(), "official package", "official packages")}, {order}. Official packages are published from the nabi-lang organization." })
    } else if terms.is_empty() && only.is_empty() {
        (tr(ko, "All packages", "모든 패키지"), if ko { f"패키지 {grouped(rows.len())}개, {order}. <a href=\"{lp(ko, "/categories")}\">카테고리</a>나 <a href=\"{lp(ko, "/keywords")}\">키워드</a>로 둘러볼 수도 있습니다." } else { f"{plural(rows.len(), "package", "packages")}, {order}. Browse by <a href=\"/categories\">category</a> or <a href=\"/keywords\">keyword</a>." })
    } else if hits.is_empty() {
        (search_title, tr(ko, f"No packages match {qt}.", f"{qt}에 맞는 패키지가 없습니다."))
    } else if !fixed.is_empty() {
        let fhref = esc(list_url + "?q=" + http::pct_encode(fixed));
        let shown = f"<a class=\"fixed\" href=\"{fhref}\"><q>{esc(fixed)}</q></a>";
        (search_title, if ko { f"{qt}에 맞는 패키지가 없습니다. {shown}의 결과를 보여 줍니다: 패키지 {grouped(hits.len())}개, {order}. {all_link}" } else { f"No packages match {qt}. Showing results for {shown}: {plural(hits.len(), "package", "packages")}, {order}. {all_link}" })
    } else {
        (search_title, if ko { f"{qt}에 맞는 패키지 {grouped(hits.len())}개, {order}. {all_link}" } else { f"{if hits.len() == 1 { "1 package matches" } else { f"{grouped(hits.len())} packages match" }} {qt}, {order}. {all_link}" })
    };
    let list = if hits.is_empty() {
        if terms.is_empty() && only.is_empty() { tr(ko, "<p class=\"empty\">No packages published yet.</p>", "<p class=\"empty\">아직 공개된 패키지가 없습니다.</p>") } else if ko { f"<p class=\"empty\">{qt}에 맞는 패키지가 없습니다. 더 짧은 단어로 찾거나, <a href=\"{list_url}\">모든 패키지</a>를 보십시오.</p>" } else { f"<p class=\"empty\">No packages match {qt}. Try a shorter word, or <a href=\"/packages\">see all packages</a>.</p>" }
    } else {
        let b = StrBuf::new();
        b.push_str("<ul class=\"rows\">");
        for h in hits { b.push_str(package_row(h.row, "", ko, terms, if terms.is_empty() { "" } else { h.why })); }
        b.push_str("</ul>");
        b.to_str()
    };
    (title, f"<div class=\"frame list-page\">
<div class=\"page-head\"><h1 class=\"t-h2\">{esc(title)}</h1><p class=\"t-small\">{note}</p></div>
{form}
{list}
</div>
")
}

// Browsing by category and keyword: /categories, /categories/<slug>,
// /keywords, /keywords/<slug>, from the latest version's metadata.

/// The address part of a category or keyword: lowercase ASCII letters
/// and digits, each run of anything else one `-`, none at the ends; ""
/// when nothing is left (a keyword in another script has no page).
pub fn slug(s: str) -> str {
    let out = StrBuf::new();
    let dash = false;
    for c in s.chars() {
        if c.is_ascii_alphanumeric() {
            if dash && out.len() > 0 { out.push('-'); }
            dash = false;
            out.push(c.to_ascii_lowercase());
        } else {
            dash = true;
        }
    }
    out.to_str()
}

/// A category or keyword and the packages whose latest version has it.
pub struct Topic {
    pub slug: str;
    /// As the first package to name it spelt it; a category with its
    /// first letter raised and `-` as spaces.
    pub label: str;
    pub packages: List<Package>;
}

/// The page of category (`cats`) or keyword `slug`.
pub fn topic_out(cats: bool, slug: str) -> str { f"{if cats { "categories" } else { "keywords" }}/{slug}.html" }

/// Where a category or keyword links: its page, or a search when it has
/// no slug.
pub fn topic_href(cats: bool, word: str, ko: bool = false) -> str {
    let s = slug(word);
    if s.is_empty() { lp(ko, "/packages?q=" + http::pct_encode(word)) } else { href(ko, topic_out(cats, s)) }
}

fn category_label(c: str) -> str {
    let t = c.trim().replace("-", " ").replace("_", " ");
    if t.is_empty() { return t; }
    if t.byte(0) < 128u8 { t[:1].to_uppercase() + t[1:] } else { t }
}

/// Every category (`cats`) or keyword of `all`, by slug; each package
/// once per topic, official ones first, then by name.
pub fn topics(all: List<Package>, cats: bool) -> List<Topic> {
    let labels: Dict<str, str> = Dict::new();
    let members: Dict<str, List<Package>> = Dict::new();
    for s in all {
        if s.library { continue; }
        let words = if cats { s.meta.categories } else { s.meta.keywords };
        for w in words {
            let k = slug(w);
            if k.is_empty() { continue; }
            if !labels.contains_key(k) {
                labels.insert(k, if cats { category_label(w) } else { w.trim().to_lowercase() });
                members.insert(k, List::new());
            }
            let ps = members[k];
            let dup = false;
            for p in ps {
                if p.name == s.name { dup = true; }
            }
            if !dup { ps.push(s); }
            members.insert(k, ps);
        }
    }
    let out: List<Topic> = List::new();
    for k in labels.keys() {
        let ps = members[k];
        ps.sort_by(|a: Package, b: Package| if a.official != b.official { b.official.cmp(a.official) } else { a.name.cmp(b.name) });
        out.push(Topic { slug: k, label: labels[k], packages: ps });
    }
    out.sort_by(|a: Topic, b: Topic| a.slug.cmp(b.slug));
    out
}

/// The links between the two indexes, the current one marked.
fn topic_switch(cats: bool, ko: bool) -> str {
    let cur = |on: bool| if on { " aria-current=\"page\"" } else { "" };
    f"<nav class=\"topic-switch t-ui\" aria-label=\"{tr(ko, "Browse by", "둘러보기 기준")}\"><a href=\"{lp(ko, "/categories")}\"{cur(cats)}>{tr(ko, "Categories", "카테고리")}</a><a href=\"{lp(ko, "/keywords")}\"{cur(!cats)}>{tr(ko, "Keywords", "키워드")}</a><a href=\"{lp(ko, "/packages")}\">{tr(ko, "All packages", "모든 패키지")}</a></nav>"
}

/// `/categories` or `/keywords`: every one with how many packages have
/// it. The page title and the body.
pub fn topics_page(ts: List<Topic>, cats: bool, ko: bool = false) -> (str, str) {
    let title = if cats { tr(ko, "Categories", "카테고리") } else { tr(ko, "Keywords", "키워드") };
    let what = if cats { "category" } else { "keyword" };
    let b = StrBuf::new();
    for t in ts { b.push_str(f"<li><a href=\"{esc(href(ko, topic_out(cats, t.slug)))}\">{esc(t.label)}</a><span class=\"ct\">{grouped(t.packages.len())}</span></li>"); }
    let list = if ts.is_empty() { if ko { f"<p class=\"empty\">아직 {title}를 밝힌 패키지가 없습니다.</p>" } else { f"<p class=\"empty\">No package names a {what} yet.</p>" } } else { f"<ul class=\"topics\">{b.to_str()}</ul>" };
    let note = if ko {
        if cats { "패키지가 매니페스트(<code class=\"ic\">categories</code>)에 밝힌 카테고리와, 카테고리마다 속한 패키지 수입니다." } else { "패키지가 매니페스트(<code class=\"ic\">keywords</code>)에 밝힌 키워드와, 키워드마다 그 키워드를 쓴 패키지 수입니다." }
    } else if cats { "The categories packages name in their manifest (<code class=\"ic\">categories</code>), with how many packages are in each." } else { "The keywords packages name in their manifest (<code class=\"ic\">keywords</code>), with how many packages have each." };
    (title, f"<div class=\"frame list-page\">
<div class=\"page-head\"><h1 class=\"t-h2\">{title}</h1><p class=\"t-small\">{count_of(ko, ts.len(), what, if cats { "categories" } else { "keywords" }, title)}. {note}</p></div>
{topic_switch(cats, ko)}
{list}
</div>
")
}

/// `/categories/<slug>` or `/keywords/<slug>`: its packages. The page
/// title, its description and the body.
pub fn topic_page(t: Topic, cats: bool, ko: bool = false) -> (str, str, str) {
    let title = if ko { f"{if cats { "카테고리" } else { "키워드" }}: {t.label}" } else if cats { f"Category: {t.label}" } else { f"Keyword: {t.label}" };
    let about = if ko { f"{if cats { "카테고리" } else { "키워드" }} {t.label}의 Nabi 패키지입니다." } else { f"Nabi packages {if cats { "in the category" } else { "with the keyword" }} {t.label}." };
    let b = StrBuf::new();
    b.push_str("<ul class=\"rows\">");
    for s in t.packages { b.push_str(package_row(row_of(s), "", ko)); }
    b.push_str("</ul>");
    let index = lp(ko, if cats { "/categories" } else { "/keywords" });
    let all = f"<a href=\"{index}\">{if cats { tr(ko, "All categories", "모든 카테고리") } else { tr(ko, "All keywords", "모든 키워드") }}</a>";
    let order = if ko { f"패키지 {grouped(t.packages.len())}개, 공식 패키지 먼저, 그다음 이름 순입니다." } else { f"{plural(t.packages.len(), "package", "packages")}, official first, then by name." };
    (title, about, f"<div class=\"frame list-page\">
<nav class=\"crumbs\" aria-label=\"{tr(ko, "Breadcrumb", "이동 경로")}\"><a href=\"{index}\">{if cats { tr(ko, "categories", "카테고리") } else { tr(ko, "keywords", "키워드") }}</a> / {esc(t.slug)}</nav>
<div class=\"page-head\"><h1 class=\"t-h2\">{esc(title)}</h1><p class=\"t-small\">{order} {all}</p></div>
{b.to_str()}
</div>
")
}

/// The registry's policies (`pages/<name>.md`, `pages/ko/<name>.md`);
/// the header's language menu leads to the other language.
pub fn legal(doc: markdown::Doc) -> str {
    f"<div class=\"frame doc\">
<article class=\"prose md\">
{doc.html}</article>
</div>
"
}

/// Body of `publishing.html`: the guide in `pages/publishing.md`; of
/// `api.html`, with another `title`, the reference in `pages/api.md`.
pub fn guide(doc: markdown::Doc, title: str, ko: bool) -> str {
    let toc = StrBuf::new();
    for h in doc.headings {
        if h.level == 2 { toc.push_str(f"<a href=\"#{esc(h.id)}\">{esc(h.text)}</a>"); }
    }
    let on = tr(ko, "On this page", "이 페이지의 내용");
    f"<div class=\"frame doc\">
<article class=\"prose md\">
<h1 class=\"t-h1\">{esc(title)}</h1>
{doc.html}</article>
<nav class=\"toc\" aria-label=\"{on}\"><h2 class=\"t-label\">{on}</h2>{toc.to_str()}</nav>
</div>
"
}

// Package pages. Each package has a readme page and three tab pages that share
// its heading and side panel.

fn sorted_versions(s: Package) -> List<Version> {
    let xs: List<Version> = List::new();
    for v in s.versions { xs.push(v); }
    xs.sort_by(|a: Version, b: Version| packages::cmp_vers(b.version, a.version));
    xs
}

fn count_deps(v: Version, kind: str) -> usize {
    let n = 0usize;
    for d in v.deps {
        if d.kind == kind { n += 1; }
    }
    n
}

/// An SPDX expression for a narrow cell: `MIT OR Apache-2.0` as
/// `MIT/Apache-2.0`, the expression itself in its title.
fn license_short(l: str) -> str {
    let s = l.replace(" OR ", "/");
    if s == l { esc(l) } else { f"<span title=\"{esc(l)}\">{esc(s)}</span>" }
}

fn commit_link(v: Version) -> str {
    let tree = packages::tree_link(v.url, v.rev);
    if tree.is_empty() { f"<code title=\"{esc(v.rev)}\">{short(v.rev)}</code>" } else { f"<a href=\"{esc(tree)}\" title=\"{esc(v.rev)}\"><code>{short(v.rev)}</code></a>" }
}

fn package_head(site: Site, s: Package, tab: str, ko: bool) -> str {
    let l = s.latest;
    // One plain line for narrow screens, where the side panel comes last.
    let sum: List<str> = List::new();
    if !l.date.is_empty() { sum.push(tr(ko, f"published {when_tag(l.date, "", false)}", f"{when_tag(l.date, "", false)} 공개")); }
    if !s.meta.license.is_empty() { sum.push(esc(s.meta.license)); }
    sum.push(count_of(ko, count_deps(l, "normal"), "dependency", "dependencies", "의존성"));
    let about = if s.desc.is_empty() { "" } else { f"<p class=\"t-lead\">{esc(s.desc)}</p>" };
    let home = esc(href(ko, package_out(s.name)));
    let notice = if !s.at.is_empty() && s.at != s.top {
        let older = packages::cmp_vers(s.at, s.top) == Ordering::Less;
        let which = if older { "an old version" } else { "not the latest release" };
        let yb = actor_link(l.yanked_by, "", ko);
        let latest = f"<a href=\"{home}\">{esc(s.top)}</a>";
        let text = if ko {
            let who = if yb.is_empty() { "" } else { f"({yb})" };
            let why = if l.yank_message.is_empty() { "" } else { f" 이유: {esc(l.yank_message)}." };
            let gone = if l.yanked { f" 이 버전은 철회되었습니다{who}. 이 버전을 고정한 프로젝트는 계속 빌드되지만, 새 프로젝트는 이 버전을 쓰지 않습니다.{why}" } else { "" };
            f"{esc(s.name)}의 {if older { "이전 버전" } else { "최신 릴리스가 아닌 버전" }}입니다. 최신 버전은 {latest}입니다.{gone}"
        } else {
            let who = if yb.is_empty() { "" } else { f" by {yb}" };
            let why = if l.yank_message.is_empty() { "" } else { f" Reason: {esc(l.yank_message)}." };
            let gone = if l.yanked { f" It is yanked{who}: projects that pinned it keep building, new ones will not resolve it.{why}" } else { "" };
            f"This is {which} of {esc(s.name)}; the latest is {latest}.{gone}"
        };
        f"<p class=\"callout help\"><span class=\"lab\">{if l.yanked { yanked_tag(ko) } else { tr(ko, "old version", "이전 버전") }}</span><span>{text}</span></p>"
    } else if l.yanked {
        f"<p class=\"callout help\"><span class=\"lab\">{yanked_tag(ko)}</span><span>{tr(ko, "Every version is yanked. Projects that pinned one in <code class=\"ic\">nabi.lock</code> keep building; new ones will not resolve this package.", "모든 버전이 철회되었습니다. <code class=\"ic\">nabi.lock</code>에 버전을 고정한 프로젝트는 계속 빌드되지만, 새 프로젝트는 이 패키지를 쓰지 않습니다.")}</span></p>"
    } else { "" };
    // Narrow screens: install right under the title (the side panel ends up last).
    let inst = if l.yanked { "" } else { f"<section class=\"inst-head\" aria-label=\"{tr(ko, "Install", "설치")}\">{install_box(s, "h", ko)}</section>\n" };
    let tabs = StrBuf::new();
    let t = |key: str, label: str, href: str, n: str| {
        let ct = if n.is_empty() { "" } else { f"<span class=\"ct\">{n}</span>" };
        if key == tab {
            f"<a href=\"{esc(href)}\" class=\"on\" aria-current=\"page\">{label}{ct}</a>"
        } else {
            f"<a href=\"{esc(href)}\">{label}{ct}</a>"
        }
    };
    tabs.push_str(t("readme", tr(ko, "Readme", "읽어보기"), href(ko, readme_out(s)), ""));
    // An executable alone has no API: no Docs tab, as on crates.io.
    if s.has_lib { tabs.push_str(f"<a href=\"{esc(docs_url(site, s.name, if s.at.is_empty() { "latest" } else { s.at }))}\">{tr(ko, "Docs", "문서")} <span aria-hidden=\"true\">↗</span></a>"); }
    tabs.push_str(t("versions", tab_title("versions", ko), href(ko, tab_out(s.name, "versions")), f"{s.versions.len()}"));
    // A version page lists its dependencies in the side panel; these two
    // tabs are the latest version's.
    if s.at.is_empty() {
        tabs.push_str(t("dependencies", tab_title("dependencies", ko), href(ko, tab_out(s.name, "dependencies")), f"{l.deps.len()}"));
        tabs.push_str(t("dependents", tab_title("dependents", ko), href(ko, tab_out(s.name, "dependents")), f"{s.rdeps.len()}"));
    }
    let tree = packages::tree_link(l.url, l.rev);
    if !tree.is_empty() { tabs.push_str(f"<a href=\"{esc(tree)}\">{tr(ko, "Source", "소스")} <span aria-hidden=\"true\">↗</span></a>"); }
    f"<div class=\"frame package-head\">
<nav class=\"crumbs\" aria-label=\"{tr(ko, "Breadcrumb", "이동 경로")}\"><a href=\"{lp(ko, "/packages")}\">{tr(ko, "packages", "패키지")}</a> / {crumbs(s, tab, ko)}</nav>
<div class=\"title\"><span class=\"gl-box {hue_class(s.name)}\">{glyph(s.name, 44, "gl")}</span><div class=\"what\"><div class=\"name-line\"><h1>{esc(s.name)}</h1><span class=\"ver{if l.yanked { " gone" } else { "" }}\">{esc(l.version)}</span>{if s.official { official_badge(ko) } else { "" }}</div>{about}</div></div>
<p class=\"sum t-small\"><span>{sum.join("</span> · <span>")}</span></p>
{notice}{osv::banner(s.advisories, s.name, l.version, ko)}{inst}<div class=\"tabs-line\"><nav class=\"tabs\" aria-label=\"{tr(ko, "Package sections", "패키지 섹션")}\">{tabs.to_str()}</nav></div>
</div>
"
}

/// The breadcrumb after `packages /`: the package, the version, the tab;
/// each but the last a link.
fn crumbs(s: Package, tab: str, ko: bool) -> str {
    let parts: List<(str, str)> = [(esc(s.name), href(ko, package_out(s.name)))];
    if !s.at.is_empty() { parts.push((esc(s.at), href(ko, ver_out(s.name, s.at)))); }
    if tab != "readme" { parts.push((tr(ko, tab, tab_title(tab, true)), "")); }
    let b: List<str> = List::new();
    for k in 0..parts.len() {
        let (text, href) = parts[k];
        b.push(if k + 1 == parts.len() { text } else { f"<a href=\"{esc(href)}\">{text}</a>" });
    }
    b.join(" / ")
}

/// The install box, as tabs: `nabi add` and the `nabi.nabion` line it
/// writes for a library, `nabi install` for an executable (`--bin` when
/// the package has both). `id` keeps the ids apart: the box is in the
/// heading on narrow screens and in the side panel on wide ones.
fn install_box(s: Package, id: str, ko: bool) -> str {
    let l = s.latest;
    if l.yanked { return if s.at.is_empty() { tr(ko, "<p class=\"t-ui muted\">Not installable: every version is yanked.</p>", "<p class=\"t-ui muted\">설치할 수 없습니다. 모든 버전이 철회되었습니다.</p>") } else { tr(ko, "<p class=\"t-ui muted\">Not installable: this version is yanked.</p>", "<p class=\"t-ui muted\">설치할 수 없습니다. 이 버전은 철회되었습니다.</p>") }; }
    // An old version is asked for exactly.
    let old = !s.at.is_empty() && s.at != s.top;
    let req = if old { "=" + l.version } else { packages::add_req(l.version) };
    let at = if old || packages::is_pre(l.version) { f"@{req}" } else { "" };
    let add = f"nabi add {s.name}{at}";
    let install = f"nabi install {if s.has_lib { "--bin " } else { "" }}{s.name}{at}";
    // As `nabi add` writes it into a multi-line nabi.nabion.
    let manifest = f"deps: {{\n    \"{s.name}\": Dep::version(\"{req}\"),\n}},";
    let tabs: List<(str, str, str)> = List::new();
    if s.has_lib {
        tabs.push(("add", "nabi add", f"<pre class=\"sh\"><code><span class=\"p\" aria-hidden=\"true\">$ </span>{esc(add)}</code></pre>{chrome::copy_button(add, ko)}"));
        tabs.push(("nabion", "nabi.nabion", f"<pre><code class=\"language-nabion\">{nabi_syntax::highlight_nabion(manifest)}</code></pre>{chrome::copy_button(manifest, ko)}"));
    }
    if packages::has_bin(s) {
        tabs.push(("bin", "nabi install", f"<pre class=\"sh\"><code><span class=\"p\" aria-hidden=\"true\">$ </span>{esc(install)}</code></pre>{chrome::copy_button(install, ko)}"));
    }
    // From the package's own API (apidoc::import_line): the library's
    // tabs only.
    let use_line = if s.import.is_empty() || !s.has_lib { "" } else { f"<div class=\"iuse\"><p class=\"t-small\">{tr(ko, "Then in your code", "그다음 코드에서")}</p><pre><code class=\"language-nabi\">{nabi_syntax::highlight_nabi(s.import)}</code></pre>{chrome::copy_button(s.import, ko)}</div>" };
    // The newest version of an official package comes in on `use` alone.
    let use_code = f"<code class=\"ic\">use {esc(s.name.replace("-", "_"))}::..;</code>";
    let auto = if s.official && s.has_lib && !old && !packages::is_pre(l.version) { tr(ko, f"<p class=\"inst-note\">Official: {use_code} alone is enough, the first build adds it. Or:</p>", f"<p class=\"inst-note\">공식 패키지: {use_code}만 쓰면 첫 빌드가 추가합니다. 또는:</p>") } else { "" };
    let heads = StrBuf::new();
    let panels = StrBuf::new();
    for k in 0..tabs.len() {
        let (key, label, body) = tabs[k];
        let first = k == 0;
        let bin = if key == "bin" { " data-bin=\"1\"" } else { "" };
        heads.push_str(f"<button type=\"button\" role=\"tab\" id=\"{id}t-{key}\" aria-controls=\"{id}p-{key}\" aria-selected=\"{first}\"{if first { "" } else { " tabindex=\"-1\"" }}{bin}>{label}</button>");
        panels.push_str(f"\n<div class=\"ipanel{if first { " on" } else { "" }}\" role=\"tabpanel\" id=\"{id}p-{key}\" aria-labelledby=\"{id}t-{key}\">{body}</div>");
        // Under the library's first tab, hidden by search.js on `nabi install`.
        if first && key == "add" { panels.push_str(use_line); }
    }
    f"<div class=\"inst\">{auto}
<div class=\"itabs\" role=\"tablist\" aria-label=\"{tr(ko, "Install with", "설치 방법")}\">{heads.to_str()}</div>{panels.to_str()}
</div>"
}

/// A GitHub login, linked to its profile; a trusted publisher
/// (`github:owner/repo/.github/workflows/<file>@<ref>`), to its workflow.
pub fn login_link(login: str, ko: bool = false) -> str {
    if let w: str = login.strip_prefix("github:") {
        let path = (w.split_once("@") ?? (w, "")).0;
        if let (repo, file) = path.split_once("/.github/workflows/") ?? ("", "") {
            if !repo.is_empty() {
                return f"<a href=\"https://github.com/{esc(repo)}/actions/workflows/{esc(http::pct_encode(file))}\" title=\"{esc(w)}\">{esc(repo)}</a> <span class=\"muted\">({tr(ko, "trusted publishing", "신뢰할 수 있는 게시")})</span>";
            }
        }
        return esc(w);
    }
    f"<a href=\"https://github.com/{esc(http::pct_encode(login))}\">{esc(login)}</a>"
}

/// A publish time `YYYY-MM-DDTHH:MMZ` as `<time>`: the date and the 24-hour
/// UTC time, or the date alone when `short`.
/// `2026-11-20 09:49 UTC` of an ISO time.
fn when_text(iso: str) -> str { if iso.len() < 16 { iso } else { f"{iso[:10]} {iso[11:16]} UTC" } }

fn when_tag(iso: str, class: str, short: bool) -> str {
    let c = if class.is_empty() { "" } else { f" class=\"{class}\"" };
    let text = if short || iso.len() < 16 { iso[:iso.len().min(10)] } else { f"{iso[:10]} {iso[11:16]} UTC" };
    f"<time{c} datetime=\"{esc(iso)}\">{esc(text)}</time>"
}

/// Who did it, after "by": a GitHub user, or for a trusted publish the
/// repository's owner "via GitHub Actions", the repository and the run;
/// "" when not known.
pub fn actor_link(a: meta::Actor | none, name: str = "", ko: bool = false) -> str {
    let x = a ?? { return ""; };
    let who = by_link(x, name, ko);
    let v = x.via ?? { return who; };
    let repo = f"https://github.com/{esc(v.repository)}";
    let run = meta::run_url(v);
    let wf = esc(http::pct_encode(v.workflow));
    let (href, title) = if run.is_empty() { (f"{repo}/actions/workflows/{wf}", v.ref) } else { (esc(run), f"{v.ref}, run {v.run_id}") };
    let tip = if title.is_empty() { "" } else { f" title=\"{esc(title)}\"" };
    let how = f"GitHub Actions (<a href=\"{repo}\">{esc(v.repository)}</a>, <a href=\"{href}\"{tip}>{esc(v.workflow)}</a>)";
    if ko { f"{who}, {how} 경유" } else { f"{who} via {how}" }
}

/// Who did it, short: the account or the repository's owner with its
/// avatar, `name` its display name; "" when not known.
pub fn by_link(x: meta::Actor, name: str = "", ko: bool = false) -> str {
    // Recorded before the run was: the workflow ref as the login.
    if x.login.starts_with("github:") { return login_link(x.login, ko); }
    let p = meta::person_of(x);
    if p.login.is_empty() { return ""; }
    if x.via is none { p.name = name; }
    person_link(p, 16)
}

/// `actor_link` as plain text, for a title attribute.
pub fn actor_text(a: meta::Actor | none, ko: bool = false) -> str {
    let x = a ?? { return ""; };
    let v = x.via ?? { return x.login; };
    if ko { f"{meta::owner_of(v)}, GitHub Actions ({v.repository}, {v.workflow}) 경유" } else { f"{meta::owner_of(v)} via GitHub Actions ({v.repository}, {v.workflow})" }
}

fn side(site: Site, s: Package, ko: bool) -> str {
    let l = s.latest;
    let m = s.meta;
    // The source the registry fetched the commit from; the manifest's
    // `repository` is only what the package says.
    let repo = packages::web_of(l.url);
    let shown = esc(bare_url(l.url)).replace("/", "/<wbr>");
    let repo_html = (if repo.is_empty() { f"<code>{shown}</code>" } else { f"<a href=\"{esc(repo)}\">{shown}</a>" }) + provenance(l, ko);
    let stated = if m.repository.is_empty() || bare_url(m.repository).to_lowercase() == bare_url(l.url).to_lowercase() { "" } else {
        let t = esc(bare_url(m.repository)).replace("/", "/<wbr>");
        let shown_stated = if m.repository.starts_with("https://") { f"<a href=\"{esc(m.repository)}\" rel=\"nofollow ugc\">{t}</a>" } else { f"<code>{t}</code>" };
        f"<dt title=\"{tr(ko, "From the package's nabi.nabion; the registry did not check it", "패키지의 nabi.nabion에 적힌 것으로, 레지스트리가 확인하지 않았습니다")}\">{tr(ko, "Stated repository", "밝힌 저장소")}</dt><dd>{shown_stated}</dd>"
    };
    let kv = StrBuf::new();
    let pb = actor_link(l.by, l.by_name, ko);
    if !l.date.is_empty() || !pb.is_empty() {
        let when = if l.date.is_empty() { "" } else { when_tag(l.date, "", false) };
        let who = if pb.is_empty() { "" } else if ko { f"{if when.is_empty() { "" } else { " · " }}{pb}" } else { f"{if when.is_empty() { "by" } else { " by" }} {pb}" };
        kv.push_str(f"<dt>{tr(ko, "Published", "공개")}</dt><dd>{when}{who}</dd>");
    }
    kv.push_str(downloads_kv(s, ko));
    kv.push_str(osv::side_kv(s.advisories, s.name, l.version, ko));
    if !m.license.is_empty() { kv.push_str(f"<dt>{tr(ko, "License", "라이선스")}</dt><dd>{esc(m.license)}</dd>"); }
    if !l.nabi_version.is_empty() { kv.push_str(f"<dt>{tr(ko, "Requires", "필요한 버전")}</dt><dd>{esc(admits(l.nabi_version, ko))}</dd>"); }
    if !m.links.is_empty() { kv.push_str(f"<dt>{tr(ko, "Links", "링크")}</dt><dd title=\"{tr(ko, "The native library it links", "링크하는 네이티브 라이브러리")}\"><code class=\"ic\">{esc(m.links)}</code></dd>"); }
    let nd = count_deps(l, "normal");
    let deps_dt = tr(ko, "Dependencies", "의존성");
    if nd == 0 {
        kv.push_str(f"<dt>{deps_dt}</dt><dd>{tr(ko, "None", "없음")}</dd>");
    } else if s.at.is_empty() {
        kv.push_str(f"<dt>{deps_dt}</dt><dd><a href=\"{esc(href(ko, tab_out(s.name, "dependencies")))}\">{nd}</a></dd>");
    } else {
        let ds: List<str> = List::new();
        for d in l.deps {
            if d.kind == "normal" { ds.push(f"<span class=\"mono\">{esc(packages::real(d))} {esc(d.req)}</span>"); }
        }
        kv.push_str(f"<dt>{deps_dt}</dt><dd>{ds.join(", ")}</dd>");
    }
    // The browse pages are the latest version's: an old version's
    // keywords and categories search instead.
    let old = !s.at.is_empty() && s.at != s.top;
    if !m.keywords.is_empty() {
        let ks: List<str> = List::new();
        for k in m.keywords { ks.push(f"<a href=\"{esc(if old { lp(ko, "/packages?q=" + http::pct_encode(k)) } else { topic_href(false, k, ko) })}\">{esc(k)}</a>"); }
        kv.push_str(f"<dt>{tr(ko, "Keywords", "키워드")}</dt><dd class=\"kws\">{ks.join(" ")}</dd>");
    }
    if !m.categories.is_empty() {
        let cs: List<str> = List::new();
        for c in m.categories { cs.push(f"<a href=\"{esc(if old { lp(ko, "/packages?q=" + http::pct_encode(c)) } else { topic_href(true, c, ko) })}\">{esc(c)}</a>"); }
        kv.push_str(f"<dt>{if ko { "카테고리" } else if cs.len() == 1 { "Category" } else { "Categories" }}</dt><dd class=\"kws\">{cs.join(" ")}</dd>");
    }
    if !m.authors.is_empty() {
        let au: List<str> = List::new();
        for a in m.authors { au.push(esc(a)); }
        kv.push_str(f"<dt>{if ko { "저자" } else if au.len() == 1 { "Author" } else { "Authors" }}</dt><dd>{au.join(", ")}</dd>");
    }
    if !m.homepage.is_empty() { kv.push_str(f"<dt>{tr(ko, "Homepage", "홈페이지")}</dt><dd><a href=\"{esc(m.homepage)}\">{esc(bare(m.homepage))}</a></dd>"); }
    if !m.documentation.is_empty() { kv.push_str(f"<dt>{tr(ko, "Documentation", "문서")}</dt><dd><a href=\"{esc(m.documentation)}\">{esc(bare(m.documentation))}</a></dd>"); }
    kv.push_str(badge_kv(site, s, ko));
    if let f: packages::Facts = s.facts {
        kv.push_str(if ko { f"<dt>크기</dt><dd>{size(f.bytes, true)}, 파일 {grouped(f.files)}개</dd>" } else { f"<dt>Size</dt><dd>{size(f.bytes)} in {plural(f.files, "file", "files")}</dd>" });
        if f.nabi_files > 0 { kv.push_str(if ko { f"<dt>Nabi 코드</dt><dd title=\".nabi 파일에서 빈 줄을 뺀 줄 수\">{grouped(f.nabi_lines)}줄, 파일 {grouped(f.nabi_files)}개</dd>" } else { f"<dt>Nabi code</dt><dd title=\"Lines that are not blank, in .nabi files\">{plural(f.nabi_lines, "line", "lines")} in {plural(f.nabi_files, "file", "files")}</dd>" }); }
    }
    let vs = sorted_versions(s);
    let vb = StrBuf::new();
    let k = 0usize;
    for v in vs {
        if k == 5 { break; }
        k += 1;
        let mark = if v.version == (if s.at.is_empty() { l.version } else { s.top }) && !v.yanked { f"<span class=\"dot\" title=\"{tr(ko, "latest", "최신")}\"></span>" } else { "<span class=\"dot off\"></span>" };
        let tag = if v.yanked { f"<span class=\"tag\">{yanked_tag(ko)}</span>" } else if packages::is_pre(v.version) { f"<span class=\"tag\">{tr(ko, "pre-release", "프리릴리스")}</span>" } else { "" };
        let when = if v.date.is_empty() { "" } else { when_tag(v.date, "c", false) };
        let cur = if v.version == s.at { " aria-current=\"page\"" } else { "" };
        vb.push_str(f"<li{if v.yanked { " class=\"yanked\"" } else { "" }}>{mark}<a class=\"v\" href=\"{esc(href(ko, ver_out(s.name, v.version)))}\"{cur}>{esc(v.version)}</a>{tag}{when}</li>");
    }
    let more = if s.versions.len() > 5 { f"<a href=\"{esc(href(ko, tab_out(s.name, "versions")))}\" class=\"t-ui\">{tr(ko, f"All {s.versions.len()} versions", f"버전 {s.versions.len()}개 모두")}</a>" } else { "" };
    f"<aside class=\"meta\" aria-label=\"{tr(ko, "Package details", "패키지 정보")}\">
<section class=\"inst-side\"><h2 class=\"t-label\">{tr(ko, "Install", "설치")}</h2>{install_box(s, "i", ko)}</section>
<dl class=\"kv\">{kv.to_str()}<dt>{tr(ko, "Repository", "저장소")}</dt><dd>{repo_html}</dd>{stated}<dt>{tr(ko, "Commit", "커밋")}</dt><dd class=\"mono\">{commit_link(l)}</dd><dt>{tr(ko, "Tree hash", "트리 해시")}</dt><dd class=\"mono\"><code title=\"{esc(l.tree)}\">{short(l.tree)}</code></dd><dt>{tr(ko, "Index file", "index 파일")}</dt><dd class=\"mono\"><a href=\"{esc(site.index_repo)}/blob/main/{esc(s.file)}\">{esc(s.file)}</a></dd></dl>
{owners_box(s, ko)}{publishers_box(s, ko)}<section class=\"vers\"><h2 class=\"t-label\">{tr(ko, "Versions", "버전")}</h2><ul>{vb.to_str()}</ul>{dates_note(s, ko)}{more}</section>
</aside>
"
}

/// packages::admits in the page's language: `nabi 0.2.0 or a later 0.2.x`.
fn admits(nabi_version: str, ko: bool) -> str {
    let en = packages::admits(nabi_version);
    if !ko { return en; }
    // `nabi 0.2.0 or a later 0.2.x`, or another form left as it is.
    if let (a, b): (str, str) = en.split_once(" or a later ") { return f"{a} 이상 {b}"; }
    en
}

// Structured data (schema.org, JSON-LD) for search engines: a package
// page's SoftwareSourceCode, and the breadcrumbs of the pages that show
// them.

/// `json` as a `<script type="application/ld+json">`; `</` escaped so
/// no text in it ends the script.
fn ld_script(json: str) -> str { f"<script type=\"application/ld+json\">{json.replace("</", "<\\/")}</script>\n" }

fn js(s: str) -> str { build::json_str(s) }

/// A BreadcrumbList of `items`: each a name and a root-relative path.
pub fn breadcrumb_ld(site: Site, items: List<(str, str)>) -> str {
    let b: List<str> = List::new();
    for k in 0..items.len() {
        let (name, path) = items[k];
        b.push(f"{{\"@type\":\"ListItem\",\"position\":{k + 1},\"name\":{js(name)},\"item\":{js(site.base_url + path)}}}");
    }
    ld_script(f"{{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{b.join(",")}]}}")
}

/// The JSON-LD of a package's page or tab `tab` (`readme`, `versions`,
/// ..): the package as SoftwareSourceCode (the version a version page
/// shows), and the page's breadcrumbs.
pub fn package_ld(site: Site, s: Package, tab: str, ko: bool = false) -> str {
    let l = s.latest;
    let m = s.meta;
    let page = href(ko, readme_out(s));
    let f: List<str> = ["\"@context\":\"https://schema.org\"", "\"@type\":\"SoftwareSourceCode\"", f"\"name\":{js(s.name)}", f"\"url\":{js(site.base_url + page)}", f"\"version\":{js(l.version)}", "\"programmingLanguage\":{\"@type\":\"ComputerLanguage\",\"name\":\"Nabi\",\"url\":\"https://nabi-lang.org\"}"];
    if !s.desc.is_empty() { f.push(f"\"description\":{js(s.desc)}"); }
    let repo = packages::web_of(l.url);
    if !repo.is_empty() { f.push(f"\"codeRepository\":{js(repo)}"); }
    if !m.license.is_empty() { f.push(f"\"license\":{js(m.license)}"); }
    if !m.keywords.is_empty() {
        let ks: List<str> = List::new();
        for k in m.keywords { ks.push(k); }
        f.push(f"\"keywords\":{js(ks.join(", "))}");
    }
    if !m.authors.is_empty() {
        let au: List<str> = List::new();
        for a in m.authors {
            // `Ann <ann@example.org>`: the name only.
            let name = (a.split_once(" <") ?? (a, "")).0.trim();
            if !name.is_empty() { au.push(f"{{\"@type\":\"Person\",\"name\":{js(name)}}}"); }
        }
        if !au.is_empty() { f.push(f"\"author\":[{au.join(",")}]"); }
    }
    if !l.date.is_empty() { f.push(f"\"dateModified\":{js(l.date)}"); }
    let first = "";
    for v in s.versions {
        if !v.date.is_empty() && (first.is_empty() || v.date < first) { first = v.date; }
    }
    if !first.is_empty() { f.push(f"\"datePublished\":{js(first)}"); }
    let crumbs: List<(str, str)> = [(tr(ko, "Packages", "패키지"), lp(ko, "/packages")), (s.name, href(ko, package_out(s.name)))];
    if !s.at.is_empty() { crumbs.push((s.at, href(ko, ver_out(s.name, s.at)))); }
    if tab != "readme" { crumbs.push((tab_title(tab, ko), href(ko, tab_out(s.name, tab)))); }
    ld_script("{" + f.join(",") + "}") + breadcrumb_ld(site, crumbs)
}

fn tab_title(tab: str, ko: bool = false) -> str {
    match tab {
        "versions" => tr(ko, "Versions", "버전"),
        "dependencies" => tr(ko, "Dependencies", "의존성"),
        "dependents" => tr(ko, "Dependents", "의존하는 패키지"),
        _ => tab,
    }
}

// Badges: `/packages/<name>/badge.svg`, the latest version as a flat
// shields-style badge for READMEs.

/// The badge of package `name`.
pub fn badge_out(name: str) -> str { f"packages/{name}/badge.svg" }

/// About how wide `text` is in 11px Verdana, as the badge draws it.
fn text_px(text: str) -> i64 {
    let w = 0i64;
    for c in text.chars() {
        w += match c {
            'i' | 'l' | 'j' | '|' | '\'' => 30i64,
            '.' | ',' | ':' | ' ' | 'f' => 39i64,
            't' => 43i64,
            'r' | '-' | '(' | ')' => 46i64,
            'm' => 107i64,
            'w' => 89i64,
            'M' | 'W' => 99i64,
            x => if x >= 'A' && x <= 'Z' { 75i64 } else if x >= '0' && x <= '9' { 70i64 } else { 65i64 },
        };
    }
    (w + 9i64) / 10i64
}

/// The flat badge of `s`: `nabi | v<latest>`, blue; orange for a
/// pre-release, grey when every version is yanked. Its title and
/// aria-label say the same for screen readers.
pub fn badge(s: Package) -> str {
    let l = s.latest;
    let (value, color) = if l.yanked { ("yanked", "#9f9f9f") } else if packages::is_pre(l.version) { ("v" + l.version, "#fe7d37") } else { ("v" + l.version, "#007ec6") };
    let label = "nabi";
    let lw = text_px(label) + 10i64;
    let vw = text_px(value) + 10i64;
    let w = lw + vw;
    let title = esc(f"{s.name}: {value} on packages.nabi-lang.org");
    let lx = lw * 5i64;
    let vx = lw * 10i64 + vw * 5i64;
    let lt = (lw - 10i64) * 10i64;
    let vt = (vw - 10i64) * 10i64;
    let v = esc(value);
    f"<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"{w}\" height=\"20\" role=\"img\" aria-label=\"{title}\"><title>{title}</title><linearGradient id=\"s\" x2=\"0\" y2=\"100%\"><stop offset=\"0\" stop-color=\"#bbb\" stop-opacity=\".1\"/><stop offset=\"1\" stop-opacity=\".1\"/></linearGradient><clipPath id=\"r\"><rect width=\"{w}\" height=\"20\" rx=\"3\" fill=\"#fff\"/></clipPath><g clip-path=\"url(#r)\"><rect width=\"{lw}\" height=\"20\" fill=\"#555\"/><rect x=\"{lw}\" width=\"{vw}\" height=\"20\" fill=\"{color}\"/><rect width=\"{w}\" height=\"20\" fill=\"url(#s)\"/></g><g fill=\"#fff\" text-anchor=\"middle\" font-family=\"Verdana,Geneva,DejaVu Sans,sans-serif\" text-rendering=\"geometricPrecision\" font-size=\"110\"><text aria-hidden=\"true\" x=\"{lx}\" y=\"150\" fill=\"#010101\" fill-opacity=\".3\" transform=\"scale(.1)\" textLength=\"{lt}\">{label}</text><text x=\"{lx}\" y=\"140\" transform=\"scale(.1)\" fill=\"#fff\" textLength=\"{lt}\">{label}</text><text aria-hidden=\"true\" x=\"{vx}\" y=\"150\" fill=\"#010101\" fill-opacity=\".3\" transform=\"scale(.1)\" textLength=\"{vt}\">{v}</text><text x=\"{vx}\" y=\"140\" transform=\"scale(.1)\" fill=\"#fff\" textLength=\"{vt}\">{v}</text></g></svg>\n"
}

/// The side panel's badge: the image and its Markdown to copy.
fn badge_kv(site: Site, s: Package, ko: bool) -> str {
    if !s.at.is_empty() && s.at != s.top { return ""; }
    let page = site.base_url + url(package_out(s.name));
    let src = url(badge_out(s.name));
    let md = f"[![{s.name} on packages.nabi-lang.org]({site.base_url}{src})]({page})";
    f"<dt>{tr(ko, "Badge", "배지")}</dt><dd class=\"badge\"><img src=\"{esc(src)}\" alt=\"{esc(s.name)} {esc(if s.latest.yanked { "yanked" } else { "v" + s.latest.version })}\" height=\"20\" loading=\"lazy\">{chrome::copy_button(md, ko)}</dd>"
}

/// A count of downloads, grouped by thousands.
fn count_text(n: i64) -> str { grouped(if n < 0i64 { 0usize } else { n as usize }) }

/// The side panel's Downloads: every version's on the package's pages,
/// the version's own on a version page; "" when none were counted.
fn downloads_kv(s: Package, ko: bool) -> str {
    let (total, recent) = if s.at.is_empty() {
        let t = -1i64;
        let r = 0i64;
        for v in s.versions {
            if v.downloads < 0i64 { continue; }
            t = if t < 0i64 { v.downloads } else { t + v.downloads };
            r += v.recent;
        }
        (t, r)
    } else { (s.latest.downloads, s.latest.recent) };
    if total < 0i64 { return ""; }
    if ko {
        let what = if s.at.is_empty() { "모든 버전의 소스 보관본 내려받기 수" } else { "이 버전의 소스 보관본 내려받기 수" };
        return f"<dt>내려받기</dt><dd title=\"{what}\">{count_text(total)} <span class=\"muted\">· 최근 90일 {count_text(recent)}</span></dd>";
    }
    let what = if s.at.is_empty() { "Downloads of the source archive, every version" } else { "Downloads of this version's source archive" };
    f"<dt>Downloads</dt><dd title=\"{what}\">{count_text(total)} <span class=\"muted\">· {count_text(recent)} in the last 90 days</span></dd>"
}

/// An address without `https://` and `.git`.
fn bare_url(u: str) -> str {
    let x = bare(u);
    x.strip_suffix(".git") ?? x
}

/// Whether version `v` was published by GitHub Actions in the repository
/// it names as its source: then the source is the publisher's own. The
/// fetch only shows the commit is on a branch or tag there.
pub fn verified(v: Version) -> bool {
    let by = v.by ?? { return false; };
    let via = by.via ?? { return false; };
    let src = bare_url(v.url).to_lowercase();
    src == "github.com/" + via.repository.to_lowercase()
}

/// The mark after the side panel's Repository.
fn provenance(v: Version, ko: bool) -> str {
    if verified(v) {
        return f" <span class=\"tag acc\" title=\"{tr(ko, "Published by GitHub Actions in this repository", "이 저장소의 GitHub Actions가 공개했습니다")}\">{tr(ko, "verified", "확인됨")}</span>";
    }
    f" <span class=\"tag\" title=\"{tr(ko, "The commit is on a branch or tag of this repository; nothing shows that its owners published it", "커밋이 이 저장소의 브랜치나 태그에 있습니다. 저장소 소유자가 공개했다는 근거는 없습니다")}\">{tr(ko, "not verified", "확인되지 않음")}</span>"
}

/// The side panel's Owners: each with its avatar, linked to GitHub; ""
/// when none is known.
fn owners_box(s: Package, ko: bool) -> str {
    if s.owners.is_empty() { return ""; }
    let b = StrBuf::new();
    for p in s.owners {
        let note = if p.derived { f" <span class=\"t-small muted\" title=\"{tr(ko, "Owner of a trusted publisher's repository", "신뢰할 수 있는 게시자 저장소의 소유자")}\">{tr(ko, "trusted publishing", "신뢰할 수 있는 게시")}</span>" } else { "" };
        b.push_str(f"<li>{person_link(p, 24)}{note}</li>");
    }
    f"<section class=\"owners\" aria-labelledby=\"owners\"><h2 class=\"t-label\" id=\"owners\">{tr(ko, "Owners", "소유자")}</h2><ul class=\"people\">{b.to_str()}</ul></section>\n"
}

/// Everyone who published a version, with how many, when more than one
/// did; "" otherwise.
fn publishers_box(s: Package, ko: bool) -> str {
    let order: List<str> = List::new();
    let link: Dict<str, str> = Dict::new();
    let count: Dict<str, usize> = Dict::new();
    for v in s.versions {
        let a = v.by ?? { continue; };
        let key = meta::person_of(a).login.to_lowercase();
        if key.is_empty() { continue; }
        if !link.contains_key(key) {
            order.push(key);
            link.insert(key, by_link(a, v.by_name, ko));
            count.insert(key, 0usize);
        }
        count[key] = count[key] + 1;
    }
    if order.len() < 2 { return ""; }
    let b = StrBuf::new();
    for k in order { b.push_str(f"<li>{link[k]} <span class=\"t-small muted\">{count_of(ko, count[k], "version", "versions", "버전")}</span></li>"); }
    f"<section class=\"publishers\" aria-labelledby=\"published-by\"><h2 class=\"t-label\" id=\"published-by\">{tr(ko, "Published by", "공개한 사람")}</h2><ul class=\"people\">{b.to_str()}</ul></section>\n"
}

/// `https://x.org/a/` as `x.org/a`.
fn bare(u: str) -> str {
    let t = u.strip_prefix("https://") ?? (u.strip_prefix("http://") ?? u);
    t.strip_suffix("/") ?? t
}

/// What the version dates are, under a list that shows them.
fn dates_note(s: Package, ko: bool) -> str {
    for v in s.versions {
        if !v.date.is_empty() { return tr(ko, "<p class=\"t-small\">Dates: when the version was added to the index.</p>", "<p class=\"t-small\">날짜: 버전이 index에 추가된 때입니다.</p>"); }
    }
    ""
}

fn package_frame(site: Site, s: Package, tab: str, main: str, ko: bool) -> str {
    f"{package_head(site, s, tab, ko)}<div class=\"frame package-body\">
<div class=\"main\">
{main}</div>
{side(site, s, ko)}</div>
"
}

/// The page of a standard library tier: it ships with the toolchain, so
/// there is nothing to install and no versions; its API is in the docs.
pub fn library_page(site: Site, s: Package, ko: bool = false) -> str {
    let docs = f"{site.docs}/latest/{if ko { "ko/" } else { "" }}std/{s.name}";
    let code = s.name.replace("-", "_");
    let example = match s.name {
        "bare" => "use bare::mem::size_of;",
        "core" => "use core::collections::dict::Dict;",
        _ => "use std::fs;",
    };
    let n = f"<code class=\"ic\">{esc(s.name)}</code>";
    let line = f"<code class=\"ic\">\"{esc(code)}\"</code>";
    let text = if ko {
        f"<p>{n}은 Nabi 표준 라이브러리의 일부로, 모든 도구 모음에 함께 들어 있습니다. 추가하거나 설치할 것이 없고, 여기에는 버전도 없습니다. API는 빌드에 쓰는 도구 모음을 따릅니다.</p>
<p>어느 패키지에서든 경로로 씁니다.</p>
<pre><code class=\"language-nabi\">{nabi_syntax::highlight_nabi(example)}</code></pre>
<p>매니페스트의 <code class=\"ic\">deps</code>에 {line} 줄이 있으면 에러입니다. {esc(code)}는 도구 모음에 들어 있으니 그 줄을 지우십시오. 이 이름으로는 어떤 패키지도 공개할 수 없습니다.</p>
<p><a href=\"{esc(docs)}\">{esc(s.name)} API 문서</a></p>"
    } else {
        f"<p>{n} is part of the Nabi standard library and ships with every toolchain: there is nothing to add or install, and it has no versions here. Its API follows the toolchain you build with.</p>
<p>Use it by its path, from any package:</p>
<pre><code class=\"language-nabi\">{nabi_syntax::highlight_nabi(example)}</code></pre>
<p>A {line} line in a manifest's <code class=\"ic\">deps</code> is an error: {esc(code)} ships with the toolchain; remove the line. No package can be published under this name.</p>
<p><a href=\"{esc(docs)}\">API documentation of {esc(s.name)}</a></p>"
    };
    f"<div class=\"frame package-head\">
<nav class=\"crumbs\" aria-label=\"{tr(ko, "Breadcrumb", "이동 경로")}\"><a href=\"{lp(ko, "/packages")}\">{tr(ko, "packages", "패키지")}</a> / {esc(s.name)}</nav>
<div class=\"title\"><span class=\"gl-box {hue_class(s.name)}\">{glyph(s.name, 44, "gl")}</span><div class=\"what\"><div class=\"name-line\"><h1>{esc(s.name)}</h1><span class=\"ver\">{with_toolchain(ko)}</span>{official_badge(ko)}</div><p class=\"t-lead\">{esc(desc_in(s.name, s.desc, true, ko))}</p></div></div>
</div>
<div class=\"frame package-body\">
<div class=\"main\">
<article class=\"prose\">
{text}
</article>
</div>
<aside class=\"meta\" aria-label=\"{tr(ko, "Package details", "패키지 정보")}\">
<dl class=\"kv\"><dt>{tr(ko, "Ships with", "포함")}</dt><dd>{tr(ko, "every nabi toolchain", "모든 nabi 도구 모음")}</dd><dt>{tr(ko, "Docs", "문서")}</dt><dd><a href=\"{esc(docs)}\">{esc(bare(docs))}</a></dd><dt>{tr(ko, "Index file", "index 파일")}</dt><dd class=\"mono\"><a href=\"{esc(site.index_repo)}/blob/main/{esc(s.file)}\">{esc(s.file)}</a></dd></dl>
<section class=\"owners\" aria-labelledby=\"owners\"><h2 class=\"t-label\" id=\"owners\">{tr(ko, "Owners", "소유자")}</h2><ul class=\"people\"><li><a href=\"https://github.com/nabi-lang\">nabi-lang</a></li></ul></section>
</aside>
</div>
"
}

pub fn package_page(site: Site, s: Package, ko: bool = false) -> str {
    let l = s.latest;
    let readme = if s.readme.is_empty() {
        tr(ko, "<p class=\"empty\">No README to show: the repository has none, or the build was offline.</p>", "<p class=\"empty\">보여 줄 README가 없습니다. 저장소에 README가 없거나, 빌드가 오프라인이었습니다.</p>")
    } else {
        let src = packages::web_of(l.url).replace("https://", "");
        let from = if src.is_empty() { "" } else if ko { f"<p class=\"from t-small\">README 출처: {esc(src)}, 커밋 <span class=\"mono\">{short(l.rev)}</span>.</p>" } else { f"<p class=\"from t-small\">Readme from {esc(src)} at <span class=\"mono\">{short(l.rev)}</span>.</p>" };
        // The README as its author wrote it, whatever the page's language.
        f"<article class=\"prose md readme\"{if ko { " lang=\"en\"" } else { "" }}>\n{s.readme}</article>\n{from}"
    };
    package_frame(site, s, "readme", readme, ko)
}

/// The Versions table's Docs cell of version `v`.
fn docs_cell(site: Site, s: Package, v: str, ko: bool) -> str {
    for x in s.views {
        if x.at != v { continue; }
        let href = esc(docs_url(site, s.name, v));
        if x.api_none == "" { return f"<a href=\"{href}\">{tr(ko, "docs", "문서")}</a>"; }
        if x.api_none == "failed" {
            let why = if let st: Status = x.docs { st.message } else { "" };
            return f"<a href=\"{href}\" class=\"tag\" title=\"{esc(why)}\">{tr(ko, "failed", "실패")}</a>";
        }
    }
    f"<span class=\"muted\">{tr(ko, "none", "없음")}</span>"
}

pub fn versions_page(site: Site, s: Package, ko: bool = false) -> str {
    let b = StrBuf::new();
    let counted = false;
    for v in s.versions {
        if v.downloads >= 0i64 { counted = true; }
    }
    for v in sorted_versions(s) {
        let tags = StrBuf::new();
        if v.version == s.latest.version && !v.yanked { tags.push_str(f"<span class=\"tag acc\">{tr(ko, "latest", "최신")}</span>"); }
        let page = esc(href(ko, ver_out(s.name, v.version)));
        if v.yanked {
            let why = if v.yank_message.is_empty() { "" } else { f": {v.yank_message}" };
            let yb = actor_text(v.yanked_by, ko);
            let said = if ko { f"철회{if yb.is_empty() { "" } else { f" ({yb})" }}{why}" } else { f"yanked{if yb.is_empty() { "" } else { f" by {yb}" }}{why}" };
            let by = if yb.is_empty() && why.is_empty() { "" } else { f" title=\"{esc(said)}\"" };
            tags.push_str(f"<span class=\"tag\"{by}>{yanked_tag(ko)}</span>");
        }
        if packages::is_pre(v.version) { tags.push_str(f"<span class=\"tag\">{tr(ko, "pre-release", "프리릴리스")}</span>"); }
        if !osv::affecting(s.advisories, s.name, v.version).is_empty() { tags.push_str(f"<span class=\"tag vuln\" title=\"{tr(ko, "A security advisory affects it", "보안 권고가 이 버전에 해당합니다")}\">{tr(ko, "advisory", "보안 권고")}</span>"); }
        // The day; the time is in the title.
        let none_yet = f"<span class=\"muted\">{tr(ko, "unknown", "알 수 없음")}</span>";
        let when = if v.date.is_empty() { none_yet } else { when_tag(v.date, "", true).replace("<time ", f"<time title=\"{esc(when_text(v.date))}\" ") };
        let who = if let a: meta::Actor = v.by {
            let pb = by_link(a, v.by_name, ko);
            if pb.is_empty() { none_yet } else if a.via is none { pb } else { f"<span class=\"via\" title=\"{esc(actor_text(a, ko))}\">{pb}</span>" }
        } else { none_yet };
        let sz = if let n: i64 = v.meta.size { size(n, ko) } else { none_yet };
        let tc = if v.nabi_version.is_empty() { f"<span class=\"muted\">{tr(ko, "any", "제한 없음")}</span>" } else { f"<span title=\"{esc(admits(v.nabi_version, ko))}\">{esc(v.nabi_version)}+</span>" };
        let lic = if v.license.is_empty() { f"<span class=\"muted\">{tr(ko, "none", "없음")}</span>" } else { license_short(v.license) };
        let dl = if counted { f"<td class=\"num\" title=\"{tr(ko, f"{count_text(v.recent)} in the last 90 days", f"최근 90일 {count_text(v.recent)}")}\">{count_text(v.downloads)}</td>" } else { "" };
        b.push_str(f"<tr{if v.yanked { " class=\"yanked\"" } else { "" }}><td class=\"ver\"><a class=\"v\" href=\"{page}\">{esc(v.version)}</a>{tags.to_str()}</td><td>{when}</td><td class=\"by\">{who}</td><td>{lic}</td><td class=\"num\">{sz}</td>{dl}<td>{tc}</td><td class=\"links\">{docs_cell(site, s, v.version, ko)}<span class=\"sep\" aria-hidden=\"true\"> · </span>{commit_link(v)}</td></tr>");
    }
    let (summary, about) = if ko {
        ("새 버전부터, 시각은 UTC입니다. 열 설명", f"공개는 버전의 줄이 index에 추가된 때입니다. 크기는 <code class=\"ic\">nabi publish</code>가 묶은 패키지의 크기입니다{if counted { ". 내려받기는 소스 보관본의 전체 기간 수이며, 마우스를 올리면 최근 90일 수가 보입니다" } else { "" }}. Nabi는 빌드할 수 있는 가장 오래된 도구 모음입니다. <code class=\"ic\">0.1.0+</code>는 0.1.0 이상의 0.1.x를 뜻합니다. 커밋의 제목에 전체 해시가 있고, 트리 해시는 버전 페이지에 있습니다. 철회된 버전은 그 버전을 고정한 프로젝트를 위해 index에 남고, 새로 의존성을 풀 때는 건너뜁니다.")
    } else {
        ("Newest first, times in UTC. About these columns", f"Published is when the version's line was added to the index. Size is the package as <code class=\"ic\">nabi publish</code> packed it{if counted { "; downloads are of its source archive, all time (hover for the last 90 days)" } else { "" }}. Nabi is the oldest toolchain it builds with: <code class=\"ic\">0.1.0+</code> means 0.1.0 or a later 0.1.x. The commit's title holds its full hash; the version's page has its tree hash. A yanked version stays in the index for the projects that pinned it; new resolves skip it.")
    };
    let th = |en: str, kr: str, cls: str| f"<th scope=\"col\"{cls}>{tr(ko, en, kr)}</th>";
    let num = " class=\"num\"";
    let head = th("Version", "버전", "") + th("Published", "공개", "") + th("By", "공개한 사람", "") + th("License", "라이선스", "") + th("Size", "크기", num) + (if counted { th("Downloads", "내려받기", num) } else { "" }) + th("Nabi", "Nabi", "") + th("Docs · commit", "문서 · 커밋", "");
    let body = f"<h2 class=\"t-h3\">{count_of(ko, s.versions.len(), "version", "versions", "버전")}</h2>
<details class=\"about t-ui\"><summary>{summary}</summary><p class=\"muted\">{about}</p></details>
<div class=\"table-wrap\"><table class=\"tbl vtbl\"><thead><tr>{head}</tr></thead><tbody>{b.to_str()}</tbody></table></div>
";
    package_frame(site, s, "versions", body, ko)
}

fn dep_rows(have: Set<str>, deps: List<packages::Req>, kind: str, ko: bool) -> str {
    let b = StrBuf::new();
    for d in deps {
        if d.kind != kind { continue; }
        let dn = packages::real(d);
        let name = if !d.registry.is_empty() {
            f"<span class=\"mono\">{esc(dn)}</span> <span class=\"tag\" title=\"{esc(d.registry)}\">{tr(ko, "other index", "다른 index")}</span>"
        } else if have.contains(dn) {
            f"<a class=\"mono\" href=\"{esc(href(ko, package_out(dn)))}\">{esc(dn)}</a>"
        } else {
            f"<span class=\"mono\">{esc(dn)}</span> <span class=\"tag\">{tr(ko, "not in index", "index에 없음")}</span>"
        };
        let alias = if dn == d.name { "" } else { f" <span class=\"muted\">{tr(ko, "as", "별칭")}</span> <span class=\"mono\">{esc(d.name)}</span>" };
        let only = if d.target.is_empty() { "" } else { f" <span class=\"tag\" title=\"{tr(ko, "only for this target", "이 대상에서만")}\">{esc(d.target)}</span>" };
        b.push_str(f"<tr><td>{name}{alias}{only}</td><td class=\"mono\">{esc(d.req)}</td></tr>");
    }
    b.to_str()
}

fn dep_table(rows: str, ko: bool) -> str {
    f"<div class=\"table-wrap\"><table class=\"tbl\"><thead><tr><th scope=\"col\">{tr(ko, "Package", "패키지")}</th><th scope=\"col\">{tr(ko, "Requirement", "요구 버전")}</th></tr></thead><tbody>{rows}</tbody></table></div>"
}

pub fn deps_page(site: Site, s: Package, have: Set<str>, ko: bool = false) -> str {
    let l = s.latest;
    let deps = dep_rows(have, l.deps, "normal", ko);
    let dev = dep_rows(have, l.deps, "dev", ko);
    let b = StrBuf::new();
    b.push_str(f"<h2 class=\"t-h3\">{tr(ko, f"Dependencies of {esc(l.version)}", f"{esc(l.version)}의 의존성")}</h2>\n");
    b.push_str(if deps.is_empty() { tr(ko, "<p class=\"empty\">None. This package builds on the standard library alone.</p>\n", "<p class=\"empty\">없습니다. 이 패키지는 표준 라이브러리만으로 빌드됩니다.</p>\n") } else { dep_table(deps, ko) });
    if !dev.is_empty() { b.push_str(f"<h2 class=\"t-h3\">{tr(ko, "Dev dependencies", "개발 의존성")}</h2>\n<p class=\"t-ui muted\">{tr(ko, "Used by its tests and examples only.", "테스트와 예제에서만 씁니다.")}</p>\n{dep_table(dev, ko)}"); }
    if !l.features.is_empty() {
        let fs = StrBuf::new();
        for (name, on) in l.features {
            let what = StrBuf::new();
            for e in on { what.push_str(f"<code class=\"ic\">{esc(e)}</code> "); }
            fs.push_str(f"<tr><td class=\"mono\">{esc(name)}</td><td>{if what.is_empty() { f"<span class=\"muted\">{tr(ko, "nothing else", "다른 것 없음")}</span>" } else { what.to_str() }}</td></tr>");
        }
        b.push_str(f"<h2 class=\"t-h3\">{tr(ko, "Features", "기능")}</h2>\n<div class=\"table-wrap\"><table class=\"tbl\"><thead><tr><th scope=\"col\">{tr(ko, "Feature", "기능")}</th><th scope=\"col\">{tr(ko, "Turns on", "함께 켜는 것")}</th></tr></thead><tbody>{fs.to_str()}</tbody></table></div>\n");
    }
    package_frame(site, s, "dependencies", b.to_str(), ko)
}

pub fn dependents_page(site: Site, s: Package, ko: bool = false) -> str {
    let b = StrBuf::new();
    b.push_str(f"<h2 class=\"t-h3\">{tr(ko, f"Packages that depend on {esc(s.name)}", f"{esc(s.name)}에 의존하는 패키지")}</h2>\n<p class=\"t-ui muted\">{tr(ko, "Counted from the latest version of every package in the index.", "index에 있는 모든 패키지의 최신 버전에서 셉니다.")}</p>\n");
    if s.rdeps.is_empty() {
        b.push_str(tr(ko, "<p class=\"empty\">None yet.</p>\n", "<p class=\"empty\">아직 없습니다.</p>\n"));
    } else {
        let rows = StrBuf::new();
        for d in s.rdeps {
            rows.push_str(f"<tr><td><a class=\"mono\" href=\"{esc(href(ko, package_out(d.name)))}\">{esc(d.name)}</a></td><td class=\"mono\">{esc(d.req)}</td></tr>");
        }
        b.push_str(dep_table(rows.to_str(), ko));
    }
    package_frame(site, s, "dependents", b.to_str(), ko)
}

/// Body of `404.html` (`ko/404.html` in Korean), the 404 every Nabi site
/// shares; search.js names the path.
pub fn not_found(ko: bool = false) -> str {
    if ko {
        let sentence = "이 주소에는 패키지나 페이지가 없습니다: <code id=\"lost-path\">이 주소</code>. <kbd class=\"kbd\">/</kbd>로 검색하거나, 다음으로 이동하십시오.";
        return f"<div class=\"frame lost-page\">{chrome::not_found("페이지를 찾을 수 없습니다", sentence, [("/ko/packages", "모든 패키지"), ("/ko/publishing", "패키지 공개"), ("/ko", "레지스트리 홈")])}</div>\n";
    }
    let sentence = "There is no package or page at <code id=\"lost-path\">this address</code>. Search with <kbd class=\"kbd\">/</kbd>, or go to:";
    f"<div class=\"frame lost-page\">{chrome::not_found("Page not found", sentence, [("/packages", "All packages"), ("/publishing", "Publishing"), ("/", "Registry home")])}</div>\n"
}

#[cfg(test)]
fn row(name: str, desc: str, kws: List<str>, time: i64) -> Row {
    Row { name: name, version: "0.1.0", desc: desc, keywords: kws, yanked: false, time: time, date: "", official: false }
}

#[test]
fn searching() {
    let rows = [row("json5", "JSON5 reader", List::new(), 3i64), row("json", "JSON values", List::new(), 1i64), row("geom", "2D shapes", ["geometry"], 2i64), row("ajson", "another json", List::new(), 4i64)];
    let names = |hs: List<Hit>| {
        let out: List<str> = List::new();
        for h in hs { out.push(h.row.name); }
        out.join(",")
    };
    assert(names(search(rows, "json", "relevance")) == "json,json5,ajson", "relevance");
    assert(names(search(rows, "json", "name")) == "ajson,json,json5", "name");
    assert(names(search(rows, "json", "updated")) == "ajson,json5,json", "updated");
    assert(names(search(rows, "geometry", "")) == "geom" && search(rows, "geometry", "")[0].why == "keywords", "keywords");
    assert(search(rows, "json xml", "").is_empty() && search(rows, "", "").len() == 4, "every term");
    assert(marked("A <json> JSON", ["json"]) == "A &lt;<mark>json</mark>&gt; <mark>JSON</mark>", "marks");
    let (title, body) = list_page(rows, "nope", "");
    assert(title == "Search: nope" && body.contains("No packages match <q>nope</q>") && body.contains("href=\"/packages\""), "no match");
    assert(list_page(rows, "", "updated").1.contains("<option value=\"updated\" selected>"), "sort kept");
    rows[3].official = true;
    assert(names(search(rows, "json", "relevance")) == "json,json5,ajson", "official only breaks ties");
    rows[1].official = true;
    assert(names(search(rows, "jso", "relevance")) == "json,json5,ajson", "official first among equals");
    rows[1].official = false;
    rows[0].official = true;
    assert(names(search(rows, "jso", "relevance")) == "json5,json,ajson", "official first among equals");
    assert(names(search(rows, "official:yes", "name")) == "ajson,json5" && names(search(rows, "json official:no", "relevance")) == "json", "filter");
    assert(terms_of("Json official:yes").join(",") == "json" && filter_of("official:YES") == "yes" && filter_of("official:x").is_empty(), "filter terms");
    let (ot, ob) = list_page(rows, "official:yes", "");
    assert(ot == "Official packages" && ob.contains("2 official packages") && ob.contains("class=\"official\""), ob);
}

#[test]
fn typos() {
    let rows = [row("json", "JSON values", List::new(), 1i64), row("linalg", "Dense matrices", ["linear-algebra"], 2i64), row("nabi-syntax", "Highlighting", List::new(), 3i64), row("geom", "2D shapes", ["geometry"], 4i64)];
    let fix = |q: str| corrected(rows, q) ?? "-";
    assert(fix("jsn") == "json" && fix("lnalg") == "linalg" && fix("Jsno") == "json", fix("jsn"));
    assert(fix("sytnax") == "syntax" && fix("geometyr") == "geometry" && fix("linera") == "linear", fix("sytnax"));
    assert(fix("json") == "-" && fix("shapes") == "-" && fix("zzzzzz") == "-" && fix("jq") == "-", "nothing to correct");
    assert(fix("jsn official:yes") == "json official:yes" && fix("dense lnalg") == "dense linalg", fix("dense lnalg"));
    let (title, body) = list_page(rows, "lnalg", "");
    assert(title == "Search: lnalg" && body.contains("No packages match <q>lnalg</q>. Showing results for <a class=\"fixed\" href=\"/packages?q=linalg\"><q>linalg</q></a>: 1 package") && body.contains("<b class=\"nm\"><mark>linalg</mark></b>"), body);
    assert(list_page(rows, "zzzzzz", "").1.contains("No packages match <q>zzzzzz</q>. Try"), "no correction");
}

#[test]
fn near_names() {
    let names = ["json", "json5", "toml", "http", "markdown"];
    assert(closest(names, "jsno").join(",") == "json,json5", closest(names, "jsno").join(","));
    assert(closest(names, "mark").join(",") == "markdown", "contained");
    assert(closest(names, "zzzzzz").is_empty(), "nothing near");
}

#[test]
fn publishers() {
    assert(actor_link(none).is_empty() && actor_text(none).is_empty(), "unknown");
    let ann = meta::Actor { id: 7i64, login: "ann", at: 1i64 };
    let ann_av = "<img class=\"av\" src=\"https://avatars.githubusercontent.com/u/7?s=32&v=4\" width=\"16\" height=\"16\" alt=\"\" loading=\"lazy\" decoding=\"async\">";
    assert(actor_link(ann) == f"<a class=\"who\" href=\"https://github.com/ann\">{ann_av}<span>ann</span></a>", actor_link(ann));
    assert(actor_link(ann, "Ann Lee") == f"<a class=\"who\" href=\"https://github.com/ann\" title=\"ann\">{ann_av}<span>Ann Lee</span></a>", actor_link(ann, "Ann Lee"));
    let v = meta::Via { repository: "nabi-lang/json", workflow: "publish.yml", ref: "refs/tags/v0.2.0", run_id: "123", run_attempt: "1", owner_id: 341800840i64 };
    let t = meta::Actor { id: 7i64, login: "ann", at: 1i64, via: v };
    let org = "<a class=\"who\" href=\"https://github.com/nabi-lang\"><img class=\"av\" src=\"https://avatars.githubusercontent.com/u/341800840?s=32&v=4\" width=\"16\" height=\"16\" alt=\"\" loading=\"lazy\" decoding=\"async\"><span>nabi-lang</span></a>";
    let want = f"{org} via GitHub Actions (<a href=\"https://github.com/nabi-lang/json\">nabi-lang/json</a>, <a href=\"https://github.com/nabi-lang/json/actions/runs/123\" title=\"refs/tags/v0.2.0, run 123\">publish.yml</a>)";
    assert(actor_link(t) == want, actor_link(t));
    // The account that started the run is not who it is shown as.
    assert(by_link(t, "Ann Lee") == org, by_link(t, "Ann Lee"));
    assert(actor_text(t) == "nabi-lang via GitHub Actions (nabi-lang/json, publish.yml)", actor_text(t));
    let w = meta::Via { repository: "nabi-lang/json", workflow: "publish.yml", ref: "refs/tags/v0.2.0" };
    let anon = meta::Actor { id: 0i64, login: "", at: 1i64, via: w };
    let w2 = "<a class=\"who\" href=\"https://github.com/nabi-lang\"><span>nabi-lang</span></a> via GitHub Actions (<a href=\"https://github.com/nabi-lang/json\">nabi-lang/json</a>, <a href=\"https://github.com/nabi-lang/json/actions/workflows/publish.yml\" title=\"refs/tags/v0.2.0\">publish.yml</a>)";
    assert(actor_link(anon) == w2, actor_link(anon));
    let wf = meta::Actor { id: 0i64, login: "github:acme/geom/.github/workflows/publish.yml@refs/tags/v1", at: 1i64 };
    assert(actor_link(wf).contains("(trusted publishing)"), actor_link(wf));
}

#[test]
fn people() {
    let team = meta::Person { login: "serde-rs/publish", id: 9i64, org: true };
    let want = "<a class=\"who\" href=\"https://github.com/orgs/serde-rs/teams/publish\"><img class=\"av org\" src=\"https://avatars.githubusercontent.com/u/9?s=48&v=4\" width=\"24\" height=\"24\" alt=\"\" loading=\"lazy\" decoding=\"async\"><span>serde-rs/publish</span></a>";
    assert(person_link(team, 24) == want, person_link(team, 24));
    assert(avatar(0i64, 20, false).is_empty(), "no avatar without an id");
    let page = f"<header>{LOGIN_BUTTON}</header>";
    let menu = signed_in(page, "a<b", 5i64, "c\"1");
    assert(!menu.contains("href=\"/login\"") && menu.contains("<details class=\"user\">") && menu.contains("a&lt;b") && menu.contains("value=\"c&quot;1\"") && menu.contains("action=\"/logout\"") && menu.contains("/u/5?s=40&v=4"), menu);
    assert(signed_in("<p>no header</p>", "a", 5i64, "c") == "<p>no header</p>", "nothing to swap");
}

#[test]
fn browse_pages() {
    assert(slug("Linear Algebra") == "linear-algebra" && slug("--c++--") == "c" && slug("2d") == "2d" && slug("한국어") == "" && slug("a__b") == "a-b", slug("--c++--"));
    assert(topic_href(true, "Science") == "/categories/science" && topic_href(false, "한국어") == "/packages?q=%ED%95%9C%EA%B5%AD%EC%96%B4", topic_href(false, "한국어"));
    assert(category_label("command-line-utilities") == "Command line utilities", category_label("command-line-utilities"));
    let mk = |name: str, cats: List<str>, kws: List<str>, official: bool| {
        let m = packages::no_meta();
        m.categories = cats;
        m.keywords = kws;
        let v = Version { version: "1.0.0", deps: List::new(), url: "", rev: "", tree: "", yanked: false, features: List::new() };
        Package { name: name, file: "", versions: [v], latest: v, time: 0i64, date: "", readme: "", desc: "", rdeps: List::new(), facts: none, api: List::new(), api_none: "", import: "", meta: m, official: official }
    };
    let all = [mk("b", ["science"], ["Math", "math"], false), mk("a", ["Science", "parsing"], List::new(), false), mk("c", ["science"], ["한국어"], true)];
    let ts = topics(all, true);
    assert(ts.len() == 2 && ts[1].slug == "science" && ts[1].label == "Science" && ts[1].packages.len() == 3 && ts[1].packages[0].name == "c" && ts[1].packages[1].name == "a", "categories");
    let ks = topics(all, false);
    assert(ks.len() == 1 && ks[0].slug == "math" && ks[0].packages.len() == 1, "keywords: once per package, none without a slug");
    let (title, body) = topics_page(ts, true);
    assert(title == "Categories" && body.contains("<a href=\"/categories/science\">Science</a><span class=\"ct\">3</span>") && body.contains("2 categories"), body);
    let (tt, _about, tb) = topic_page(ts[1], true);
    assert(tt == "Category: Science" && tb.contains("3 packages") && tb.contains("href=\"/packages/c\""), tb);
}

#[test]
fn structured_data() {
    let v = Version { version: "1.2.0", deps: List::new(), url: "https://github.com/acme/json", rev: "", tree: "", yanked: false, features: List::new(), date: "2026-11-20T09:49Z" };
    let m = packages::no_meta();
    m.license = "MIT";
    m.authors = ["Ann Lee <ann@example.org>"];
    let s = Package { name: "json", file: "", versions: [v], latest: v, time: 0i64, date: "", readme: "", desc: "JSON </script> values", rdeps: List::new(), facts: none, api: List::new(), api_none: "", import: "", meta: m };
    let site = Site { title: "", tagline: "", index_repo: "", base_url: "https://p.test" };
    let ld = package_ld(site, s, "versions");
    assert(ld.contains("\"@type\":\"SoftwareSourceCode\",\"name\":\"json\",\"url\":\"https://p.test/packages/json\",\"version\":\"1.2.0\"") && ld.contains("\"codeRepository\":\"https://github.com/acme/json\"") && ld.contains("\"author\":[{\"@type\":\"Person\",\"name\":\"Ann Lee\"}]") && ld.contains("\"datePublished\":\"2026-11-20T09:49Z\""), ld);
    assert(ld.contains("JSON <\\/script> values") && !ld.contains("</script> values"), "script end escaped");
    assert(ld.contains("{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Versions\",\"item\":\"https://p.test/packages/json/versions\"}"), ld);
}

#[test]
fn badges() {
    let v = Version { version: "1.2.0", deps: List::new(), url: "", rev: "", tree: "", yanked: false, features: List::new() };
    let s = Package { name: "json", file: "", versions: [v], latest: v, time: 0i64, date: "", readme: "", desc: "", rdeps: List::new(), facts: none, api: List::new(), api_none: "", import: "", meta: packages::no_meta() };
    let b = badge(s);
    assert(b.starts_with("<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"") && b.contains("role=\"img\" aria-label=\"json: v1.2.0 on packages.nabi-lang.org\"><title>json: v1.2.0 on packages.nabi-lang.org</title>") && b.contains("fill=\"#007ec6\"") && b.contains(">v1.2.0</text>"), b);
    s.latest.version = "2.0.0-rc.1";
    assert(badge(s).contains("fill=\"#fe7d37\""), "pre-release");
    s.latest.yanked = true;
    assert(badge(s).contains(">yanked</text>") && badge(s).contains("fill=\"#9f9f9f\""), "yanked");
    assert(text_px("v1.2.0") > text_px("v1") && text_px("mmm") > text_px("iii"), "widths");
}
