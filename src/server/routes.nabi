// The site's routes: the API, login and the account pages handed on,
// search and the list, the files in `public/` and their cache rules,
// and the 404s that name a package.

use pkg::Site;
use pkg::json;
use pkg::layout;
use pkg::layout::{Lang, lp, tr};
use pkg::server::account::account_route;
use pkg::server::api::{api_route, open_to_all, wants_json};
use pkg::server::auth::{callback, login};
use pkg::server::limit;
use pkg::server::{Cfg, Resp, html, HTML_CACHE, IMMUTABLE, lang_path, message, shared_html};
use std::fs;
use std::nabion;
use std::thread;
use web::http;
use web::http::Request;
use web::lang;
use web::url;

/// An OG card asked for by the version render.ts drew it from (the `.v`
/// beside it), and a stylesheet or script asked for by its content
/// version (layout::asset), never change: cache them for good. Pages and
/// everything else are checked on every load (HTML_CACHE).
pub fn cache_for(site: Site, path: str, f: str, query: str) -> str {
    let v = http::form(query).get("v") ?? "";
    if path == "/og.png" || (path.starts_with("/og/") && path.ends_with(".png")) {
        let drawn = try fs::read_to_str(f + ".v") catch _ { "" };
        return if !v.is_empty() && v == drawn.trim() { IMMUTABLE } else { HTML_CACHE };
    }
    // The kit's fonts change only under a new name (web::http::FONTS).
    if path.starts_with("/fonts/") { return IMMUTABLE; }
    let want = layout::asset_version(site, path[1:]);
    if !want.is_empty() { return if v == want { IMMUTABLE } else { HTML_CACHE }; }
    HTML_CACHE
}

/// `public/.packages.nabion` (main.nabi); empty when it cannot be read.
fn rows(site: Site) -> List<layout::Row> {
    // A rebuild swaps `public/` (see route): look again a few times.
    for k in 0..4 {
        if k > 0 { thread::sleep(Duration::ms(50)); }
        let text = try fs::read_to_str(site.out + "/.packages.nabion") catch _ { continue; };
        return try nabion::from_str(text) catch _ { List::new() };
    }
    List::new()
}

/// `GET /api/health`: `ok` and the toolchain the site names, one `key
/// value` a line, for uptime checks and the release pipeline; `failing`
/// and a 503 while the package list cannot be read.
pub fn health(site: Site) -> Resp {
    let ok = fs::exists(site.out + "/.packages.nabion");
    let tc = if site.release.is_empty() { "unknown" } else { site.release };
    let body = f"{if ok { "ok" } else { "failing" }}\nnabi {tc}\npackages {rows(site).len()}\n";
    Resp { status: if ok { 200 } else { 503 }, headers: ["Content-Type: text/plain; charset=utf-8", "Cache-Control: no-store"], body: body, file: "" }
}

/// `/packages/<name>..` with no page: a 301 when the name only differs in
/// case, else a 404 naming the package (or its missing version) and the
/// closest names. None when `name` is a package and the page is something
/// else.
fn missing_package(site: Site, p: str, rest: str, query: str, lg: Lang) -> Resp | none {
    let at = |x: str| layout::lp(lg, x);
    let (raw, tail) = rest.split_once("/") ?? (rest, "");
    let name = http::pct_decode(raw, false) ?? raw;
    let names: List<str> = List::new();
    for row in rows(site) { names.push(row.name); }
    let has = names.contains(name);
    if !has {
        for n in names {
            if n == name.to_lowercase() {
                let to = at("/packages/" + n + (if tail.is_empty() { "" } else { "/" + tail }));
                return Resp { status: 301, headers: [url::moved(to, query), "Cache-Control: public, max-age=3600"], body: "", file: "" };
            }
        }
        let near: List<(str, str)> = List::new();
        for n in layout::closest(names, name) { near.push((at("/packages/" + n), n)); }
        let sentence = if near.is_empty() { tr(lg, "Nothing in the index has that name. Search with <kbd class=\"kbd\">/</kbd>, or go to:", "index에 그런 이름은 없습니다. <kbd class=\"kbd\">/</kbd>로 검색하거나, 다음으로 이동하십시오.", "索引中没有这个名称。按 <kbd class=\"kbd\">/</kbd> 搜索，或前往：", "索引中沒有這個名稱。按 <kbd class=\"kbd\">/</kbd> 搜尋，或前往：") } else { tr(lg, "Packages with a similar name:", "이름이 비슷한 패키지:", "名称相近的包：", "名稱相近的套件：") };
        near.push((at("/packages"), layout::tr(lg, "All packages", "모든 패키지", "所有包", "所有套件")));
        near.push((at("/publishing"), layout::tr(lg, "Publishing a package", "패키지 공개하기", "发布包", "發布套件")));
        let title = layout::tr(lg, f"No package named {name}", f"{name}(이)라는 패키지가 없습니다", f"没有名为 {name} 的包", f"沒有名為 {name} 的套件");
        let body = f"<div class=\"frame lost-page\">{web::chrome::not_found(title, sentence, near)}</div>\n";
        return html(404, layout::page(site, p[1:], title, body));
    }
    let ver = (tail.split_once("/") ?? (tail, "")).0;
    if !ver.is_empty() && ver.byte(0) >= 48u8 && ver.byte(0) <= 57u8 {
        let links: List<(str, str)> = [(at(f"/packages/{name}/versions"), layout::tr(lg, f"Versions of {name}", f"{name}의 버전", f"{name} 的版本", f"{name} 的版本")), (at(f"/packages/{name}"), layout::tr(lg, f"{name}, latest version", f"{name} 최신 버전", f"{name} 的最新版本", f"{name} 的最新版本"))];
        let title = layout::tr(lg, f"No version {ver} of {name}", f"{name}에는 {ver} 버전이 없습니다", f"{name} 没有 {ver} 版本", f"{name} 沒有 {ver} 版本");
        let body = f"<div class=\"frame lost-page\">{web::chrome::not_found(title, layout::tr(lg, "The index has no such version. Go to:", "index에 그런 버전이 없습니다. 다음으로 이동하십시오.", "索引中没有这个版本。前往：", "索引中沒有這個版本。前往："), links)}</div>\n";
        return html(404, layout::page(site, p[1:], title, body));
    }
    none
}

pub fn route(cfg: Cfg, site: Site, r: Request, client: str) throws -> Resp {
    let p = r.path;
    if p == "/api/health" && (r.method == "GET" || r.method == "HEAD") {
        let h = health(site);
        if (try? wants_json(r)) ?? false {
            h.body = f"{{\"status\":\"{if h.status == 200 { "ok" } else { "failing" }}\",\"nabi\":{json::quote(if site.release.is_empty() { "unknown" } else { site.release })},\"packages\":{rows(site).len()}}}\n";
            h.headers[0] = "Content-Type: application/json";
        }
        return open_to_all(h);
    }
    // The API's reference is a page.
    if p == "/api/v1" || p == "/api/v1/" {
        return Resp { status: 301, headers: ["Location: /api", "Cache-Control: public, max-age=86400"], body: "", file: "" };
    }
    if p == "/.well-known/security.txt" && (r.method == "GET" || r.method == "HEAD") {
        return Resp { status: 200, headers: ["Content-Type: text/plain; charset=utf-8", "Cache-Control: " + HTML_CACHE], body: web::chrome::security_txt(site.base_url), file: "" };
    }
    // One privacy notice and one set of terms for every Nabi site, on
    // nabi-lang.org (web::chrome::legal_links).
    for lg in lang::ALL {
        for page in ["/privacy", "/terms"] {
            let from = lp(lg, page);
            if p == from { return Resp { status: 301, headers: ["Location: https://nabi-lang.org" + from, "Cache-Control: public, max-age=86400"], body: "", file: "" }; }
        }
    }
    if p.starts_with("/api/") { return api_route(cfg, r, client); }
    if p.starts_with("/img/") {
        if !limit::allow("img:" + client, limit::READS) {
            return Resp { status: 429, headers: ["Content-Type: text/plain; charset=utf-8", "Retry-After: 60", "Cache-Control: no-store"], body: "too many images; wait a minute\n", file: "" };
        }
        return pkg::server::img::route(cfg, r);
    }
    if p == http::REPORT_PATH {
        if r.method != "POST" { return Resp { status: 405, headers: ["Content-Type: text/plain; charset=utf-8", "Cache-Control: no-store"], body: "POST only\n", file: "" }; }
        // Anyone may send one: past REPORTS a minute an address's go
        // unlogged, answered alike so a sender learns nothing. csp_report
        // reads at most MAX_REPORT bytes and logs at most 400 characters.
        if r.body.len() <= http::MAX_REPORT && limit::allow("csp:" + client, limit::REPORTS) {
            if let line: str = http::csp_report(r.body) { eprintln(line); }
        }
        return Resp { status: 204, headers: ["Cache-Control: no-store"], body: "", file: "" };
    }
    if p == http::SPECULATION_PATH && (r.method == "GET" || r.method == "HEAD") {
        return Resp { status: 200, headers: [http::SPECULATION_TYPE, "Cache-Control: public, max-age=3600"], body: http::SPECULATION_RULES, file: "" };
    }
    let post = r.method == "POST";
    let get = r.method == "GET" || r.method == "HEAD";
    // The pages in another language: `/ko`, `/zh-hans/..` and the like,
    // routed as the English path (`bare`) with the chrome in that language.
    let lg = lang_path(p);
    let bare = unlang(p);
    if (bare == "/login" || p == "/auth/github/callback") && get && !limit::allow("login:" + client, limit::LOGINS) {
        let m = message(site, p, 429, tr(lg, "Too many logins", "로그인이 너무 많습니다", "登录次数过多", "登入次數過多"), tr(lg, "Wait a minute, then log in again.", "1분 기다린 뒤 다시 로그인하십시오.", "请等一分钟，然后重新登录。", "請等一分鐘，然後重新登入。"));
        m.headers.push("Retry-After: 60");
        return m;
    }
    if bare == "/login" && get { return try login(cfg, site, p); }
    if p == "/auth/github/callback" && get { return try callback(cfg, site, r); }
    if (bare == "/me" && get) || (post && is_account_form(bare)) {
        return try account_route(cfg, site, r, client);
    }
    if !get { return message(site, p, 405, tr(lg, "Method not allowed", "허용되지 않는 메서드", "不允许的请求方法", "不允許的請求方法"), tr(lg, "Only GET here: pages are read with GET, and forms are sent from the account page.", "여기서는 GET만 받습니다. 페이지는 GET으로 읽고, 양식은 계정 페이지에서 보냅니다.", "这里只接受 GET：页面用 GET 读取，表单从账户页面提交。", "這裡只接受 GET：頁面用 GET 讀取，表單從帳戶頁面送出。")); }
    // A search or a misspelt package name scans every name.
    let costly = (bare == "/packages" && !r.query.is_empty()) || (bare.starts_with("/packages/") && http::page_file(site.out, p) is none);
    if costly && !limit::allow("read:" + client, limit::READS) {
        let m = message(site, p, 429, tr(lg, "Too many requests", "요청이 너무 많습니다", "请求过多", "請求過多"), tr(lg, "Wait a minute, then try again.", "1분 기다린 뒤 다시 시도하십시오.", "请等一分钟，然后重试。", "請等一分鐘，然後再試一次。"));
        m.headers.push("Retry-After: 60");
        return m;
    }
    if let c: str = url::canonical(p) {
        return Resp { status: 301, headers: [url::moved(c, r.query), "Cache-Control: public, max-age=3600"], body: "", file: "" };
    }
    // A search or another order: the list page, filtered and sorted here
    // (it works without JS). The bare list is a file.
    if bare == "/packages" {
        let f = http::form(r.query);
        let q = f.get("q") ?? "";
        let sort = f.get("sort") ?? "";
        if !q.trim().is_empty() || !sort.is_empty() {
            let (title, body) = layout::list_page(rows(site), q, sort, lg);
            let out = layout::in_lang("packages/index.html", lg);
            return shared_html(200, layout::page_desc(site, out, title, "", body, "", "", "", r.query));
        }
    }
    // Package names are lowercase: never let a case-insensitive file system
    // answer for `/packages/JSON`.
    if let rest: str = bare.strip_prefix("/packages/") {
        let seg = (rest.split_once("/") ?? (rest, "")).0;
        if seg != seg.to_lowercase() {
            if let m: Resp = missing_package(site, p, rest, r.query, lg) { return m; }
        }
    }
    // A rebuild renames `public/` away and the new site into its place
    // (main.nabi): in between there is no site, which is not a 404.
    for k in 0..5 {
        if k > 0 {
            if fs::exists(site.out) { break; }
            thread::sleep(Duration::ms(50));
        }
        if let f: str = http::page_file(site.out, p) {
            return Resp { status: 200, headers: [f"Content-Type: {http::content_type(f)}", "Cache-Control: " + cache_for(site, p, f, r.query)], body: "", file: f };
        }
    }
    if let rest: str = bare.strip_prefix("/packages/") {
        if let m: Resp = missing_package(site, p, rest, r.query, lg) { return m; }
    }
    // The 404 every Nabi site shares, as public/404.html has it.
    html(404, layout::page(site, p[1:], layout::tr(lg, "Not found", "페이지 없음", "页面不存在", "找不到頁面"), layout::not_found(lg)))
}

/// `p` without its language directory (`/ko`, `/zh-hans`; alone, `/`).
pub fn unlang(p: str) -> str { lang::split(p).1 }

/// Whether `p` (without its language) is a form the account pages take.
fn is_account_form(p: str) -> bool {
    p == "/logout" || p == "/me/tokens" || (p.starts_with("/me/tokens/") && p.ends_with("/revoke")) || p == "/me/trusted" || (p.starts_with("/me/trusted/") && p.ends_with("/remove")) || p == "/me/owners" || p == "/me/owners/remove" || p == "/me/invites/accept" || p == "/me/invites/decline" || p == "/me/notices" || p == "/me/versions/delete" || p == "/me/sessions/logout-all" || (p.starts_with("/me/sessions/") && p.ends_with("/logout"))
}

/// The bytes of `file`, found for `path`. A rebuild swaps `public/` for
/// the new site (main.nabi), so a file found a moment ago can be gone:
/// look it up again a few times before giving up. Never an empty 200.
pub fn read_page(site: Site, path: str, file: str) -> List<u8> | none {
    let f = file;
    for k in 0..4 {
        if k > 0 {
            thread::sleep(Duration::ms(50));
            f = http::page_file(site.out, path) ?? f;
        }
        let got = true;
        let b = try fs::read(f) catch _ {
            got = false;
            List::new()
        };
        if got { return b; }
    }
    none
}

#[test]
fn health_answers() {
    let out = f"{std::env::temp_dir()}/nabi-packages-health-{std::process::id()}";
    try fs::create_dir_all(out) catch e { panic(f"{e}"); };
    let site = Site { title: "", tagline: "", index_repo: "", out: out, release: "9.9.9" };
    let no = health(site);
    try fs::write(out + "/.packages.nabion", "[]") catch e { panic(f"{e}"); };
    let ok = health(site);
    try fs::remove_dir_all(out) catch _ {};
    assert(ok.status == 200 && ok.body == "ok\nnabi 9.9.9\npackages 0\n", ok.body);
    assert(no.status == 503 && no.body.starts_with("failing\n"), no.body);
}
