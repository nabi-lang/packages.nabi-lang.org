// The account pages: `/me` with its tokens, trusted publishers and
// owners, and the forms that change them; in Korean under `/ko/me`, whose
// forms post to `/ko/me/..` and lead back there.

use pkg::Site;
use pkg::index;
use pkg::layout;
use pkg::layout::{lp, tr};
use pkg::meta;
use pkg::secret;
use pkg::server::admin::{Audit, audit};
use pkg::server::delete;
use pkg::server::limit;
use pkg::server::mail;
use pkg::server::owners::{accept_invite, add_owner, add_trusted, managed, may_manage, remove_owner, remove_trusted};
use pkg::server::routes::unko;
use pkg::server::store::{Account, Db, Event, SCOPE_ADMIN, SESSION_COOKIE, SESSION_IDLE, SESSION_SECS, Session, TOKEN_DAYS, TOKEN_DAYS_MAX, Token, account_of, default_scopes, events_of, invites_of, load_db, now_secs, owned_by, record, save_db, scopes, seen_at, session_end, session_id, session_of};
use pkg::server::{Cfg, Resp, cookie, is_admin, ko_path, LOCK, may_act, message, page, redirect, refusal};
use pkg::trust;
use pkg::trust::TrustedPublisher;
use markdown::esc;
use std::env;
use web::http;
use web::http::Request;

const MAX_TOKENS: usize = 20;

/// `YYYY-MM-DD` (UTC) of a unix time.
pub fn date(t: i64) -> str {
    if t <= 0i64 { return "never"; }
    let z = t / 86400i64 + 719468i64;
    let era = z / 146097i64;
    let doe = z - era * 146097i64;
    let yoe = (doe - doe / 1460i64 + doe / 36524i64 - doe / 146096i64) / 365i64;
    let doy = doe - (365i64 * yoe + yoe / 4i64 - yoe / 100i64);
    let mp = (5i64 * doy + 2i64) / 153i64;
    let d = doy - (153i64 * mp + 2i64) / 5i64 + 1i64;
    let m = if mp < 10i64 { mp + 3i64 } else { mp - 9i64 };
    let y = yoe + era * 400i64 + (if m <= 2i64 { 1i64 } else { 0i64 });
    let p2 = |x: i64| if x < 10i64 { f"0{x}" } else { f"{x}" };
    f"{y}-{p2(m)}-{p2(d)}"
}

/// date() on a page: `never` is `없음` in Korean.
fn day(t: i64, ko: bool) -> str { if t <= 0i64 { tr(ko, "never", "없음") } else { date(t) } }

/// What a token scope lets it do, as the account page says it.
fn scope_text(name: str, what: str, ko: bool) -> str {
    if !ko { return what; }
    match name {
        "publish-update" => "패키지의 새 버전 공개",
        "publish-new" => "새 패키지(첫 버전) 공개",
        "yank" => "버전 철회와 철회 취소",
        "owners" => "소유자와 신뢰할 수 있는 게시자 변경",
        "admin" => "관리(관리자만)",
        _ => what,
    }
}

/// What a kind of notice is about, as the account page says it.
fn kind_text(k: str, what: str, ko: bool) -> str {
    if !ko { return what; }
    match k {
        "publish" => "내 패키지의 버전이 공개될 때",
        "yank" => "내 패키지의 버전이 철회, 철회 취소, 삭제될 때",
        "owners" => "내 패키지의 소유자가 초대, 추가, 제거될 때",
        "trusted" => "내 패키지의 신뢰할 수 있는 게시자가 추가, 제거될 때",
        "token" => "내 계정에 공개 토큰이 만들어질 때",
        _ => what,
    }
}

/// The hidden CSRF field every form carries.
fn csrf_field(csrf: str) -> str { f"<input type=\"hidden\" name=\"csrf\" value=\"{csrf}\">" }

fn me_page(cfg: Cfg, site: Site, path: str, db: Db, s: Session, fresh: str) -> Resp {
    let ko = ko_path(path);
    let a = account_of(db, s.account) ?? Account { id: 0i64, login: "", created: 0i64 };
    let csrf = esc(s.csrf);
    let b = StrBuf::new();
    let shown = if a.name.is_empty() { a.login } else { a.name };
    let gh = f"https://github.com/{esc(http::pct_encode(a.login))}";
    let as_login = f"<a href=\"{gh}\"><strong>{esc(a.login)}</strong></a>";
    b.push_str(f"<h1 class=\"t-h1\">{tr(ko, "Account", "계정")}</h1>\n<section class=\"profile\" aria-labelledby=\"profile\"><h2 class=\"sr-only\" id=\"profile\">{tr(ko, "Profile", "프로필")}</h2>{layout::avatar(a.id, 80, false)}<div class=\"who-is\"><p class=\"t-h3\">{esc(shown)}</p><p>{tr(ko, f"Logged in with GitHub as {as_login}", f"로그인한 GitHub 계정: {as_login}")}</p></div></section>\n");
    b.push_str(tr(ko, "<p class=\"t-small muted\">Your name, login and avatar come from your GitHub account; they are updated each time you log in.</p>\n", "<p class=\"t-small muted\">이름, 로그인, 아바타는 GitHub 계정에서 가져오며, 로그인할 때마다 새로 반영됩니다.</p>\n"));
    b.push_str(f"<form method=\"post\" action=\"{lp(ko, "/logout")}\">{csrf_field(csrf)}<button class=\"btn-2 btn-sm\" type=\"submit\">{tr(ko, "Log out", "로그아웃")}</button></form>\n");
    invites_section(b, csrf, db, a.id, ko);
    sessions_section(b, csrf, db, s, ko);
    notices_section(cfg, b, csrf, a, ko);
    b.push_str(f"<h2 class=\"t-h3\">{tr(ko, "Publish tokens", "공개 토큰")}</h2>\n");
    let admin = is_admin(cfg, a.id);
    let title = tr(ko, "Account", "계정");
    if !may_act(cfg, a.id) {
        b.push_str(tr(ko, "<p>Publishing is not open yet: this account can log in, but cannot create tokens, add trusted publishers or owners, publish or yank. <a href=\"/publishing#publishing\">Publishing</a> says how it works.</p>\n", "<p>아직 공개가 열리지 않았습니다. 이 계정은 로그인할 수 있지만, 토큰을 만들거나 신뢰할 수 있는 게시자나 소유자를 추가하거나, 공개하거나 철회할 수는 없습니다. <a href=\"/ko/publishing#패키지-공개\">패키지 공개</a>에서 방법을 볼 수 있습니다.</p>\n"));
        return page(site, path, title, b.to_str(), 200);
    }
    let trusted = managed(db, a.id, admin);
    if !fresh.is_empty() {
        b.push_str(f"<div class=\"callout help\"><span class=\"lab\">{tr(ko, "New token, shown once: copy it now", "새 토큰은 한 번만 보입니다. 지금 복사하십시오")}</span><pre class=\"cmd\"><code>{esc(fresh)}</code></pre><p>{tr(ko, "Save it with <code class=\"ic\">nabi login</code>, which reads it from stdin.", "<code class=\"ic\">nabi login</code>으로 저장합니다. 토큰은 표준 입력에서 읽습니다.")}</p></div>\n");
    }
    let mine: List<Token> = List::new();
    for t in db.tokens {
        if t.account == a.id { mine.push(t); }
    }
    if mine.is_empty() {
        b.push_str(tr(ko, "<p>No tokens yet.</p>\n", "<p>아직 토큰이 없습니다.</p>\n"));
    } else {
        b.push_str(f"<div class=\"table-wrap\"><table class=\"tbl\">\n<thead><tr><th scope=\"col\">{tr(ko, "Name", "이름")}</th><th scope=\"col\">{tr(ko, "Packages", "패키지")}</th><th scope=\"col\">{tr(ko, "May", "권한")}</th><th scope=\"col\">{tr(ko, "Created", "만든 날")}</th><th scope=\"col\">{tr(ko, "Expires", "만료")}</th><th scope=\"col\">{tr(ko, "Last used", "마지막 사용")}</th><th scope=\"col\"><span class=\"sr-only\">{tr(ko, "Revoke", "폐기")}</span></th></tr></thead>\n<tbody>\n");
        let now = now_secs();
        let old = false;
        for t in mine {
            let pk = if t.packages.is_empty() { f"<span class=\"muted\">{tr(ko, "all yours", "내 패키지 전부")}</span>" } else { esc(t.packages.join(", ")) };
            let ex = if t.expires <= now { f"<span class=\"tag\">{tr(ko, "expired", "만료됨")}</span> {date(t.expires)}" } else { date(t.expires) };
            let may = if t.scopes.is_empty() { tr(ko, "all but moderation <span class=\"tag\">made before scopes</span>", "관리를 뺀 전부 <span class=\"tag\">권한 범위 이전에 만듦</span>") } else { esc(t.scopes.join(", ")) };
            if t.scopes.is_empty() { old = true; }
            b.push_str(f"<tr><td>{esc(t.name)}</td><td class=\"mono\">{pk}</td><td class=\"mono\">{may}</td><td>{date(t.created)}</td><td>{ex}</td><td>{day(t.last_used, ko)}</td><td><form method=\"post\" action=\"{lp(ko, f"/me/tokens/{esc(t.id)}/revoke")}\">{csrf_field(csrf)}<button class=\"btn-2 btn-sm\" type=\"submit\">{tr(ko, "Revoke", "폐기")}</button></form></td></tr>\n");
        }
        b.push_str("</tbody>\n</table></div>\n");
        if old {
            b.push_str(if ko { f"<p class=\"t-small\">권한 범위가 생기기 전에 만든 토큰은 새 패키지와 새 버전을 공개하고, 철회하고, 소유자와 신뢰할 수 있는 게시자를 바꿀 수 있지만 관리는 할 수 없습니다{if admin { "(관리에는 admin 권한이 있는 토큰이 필요합니다)" } else { "" }}. 권한을 좁히려면 필요한 것만 고른 토큰을 새로 만들고 예전 토큰을 폐기하십시오.</p>\n" } else { f"<p class=\"t-small\">A token made before scopes may publish new packages and new versions, yank, and change owners and trusted publishers, but not moderate{if admin { " (moderation takes a token with the admin scope)" } else { "" }}. To narrow it, create a token with only what it needs and revoke the old one.</p>\n" });
        }
    }
    let boxes = StrBuf::new();
    for (name, what) in scopes() {
        if name == SCOPE_ADMIN && !admin { continue; }
        let on = if default_scopes().contains(name) { " checked" } else { "" };
        boxes.push_str(f"<label><input type=\"checkbox\" name=\"scope-{name}\" value=\"on\"{on}> {esc(scope_text(name, what, ko))} <code class=\"ic\">{name}</code></label> ");
    }
    let help = if ko { f"패키지: 쉼표로 구분한 이름을 적으면 토큰이 그 패키지에만 작동합니다. 비워 두면 내가 소유한 모든 패키지에 작동합니다. 토큰에는 그 일에 필요한 것만 주십시오. 릴리스 워크플로는 새 버전을 공개하고 철회합니다. 새 패키지나 소유자 권한은 그 일을 하는 토큰에만 체크하십시오. 토큰은 정한 날 수 동안 작동하며, 최대 {TOKEN_DAYS_MAX}일입니다." } else { f"Packages: names separated by commas, to let the token act only on those; empty, it acts for every package you own. Give a token only what its job needs: a release workflow publishes new versions and yanks; tick a new package or owners only for the token that does that. A token works for the number of days given, at most {TOKEN_DAYS_MAX}." };
    b.push_str(f"<form method=\"post\" action=\"{lp(ko, "/me/tokens")}\" class=\"token-form\">{csrf_field(csrf)}<input type=\"hidden\" name=\"scopes\" value=\"1\"><label>{tr(ko, "Name", "이름")} <input name=\"name\" maxlength=\"64\" required></label> <label>{tr(ko, "Packages", "패키지")} <input name=\"packages\" maxlength=\"512\" placeholder=\"{tr(ko, "all yours", "내 패키지 전부")}\" aria-describedby=\"token-help\"></label> <label>{tr(ko, "Days", "일 수")} <input name=\"days\" type=\"number\" min=\"1\" max=\"{TOKEN_DAYS_MAX}\" value=\"{TOKEN_DAYS}\" required></label> <fieldset class=\"scopes\"><legend>{tr(ko, "It may", "권한")}</legend>{boxes.to_str()}</fieldset> <button class=\"btn btn-sm\" type=\"submit\">{tr(ko, "Create token", "토큰 만들기")}</button></form>\n<p class=\"t-small muted\" id=\"token-help\">{help}</p>\n");
    trusted_section(b, csrf, trusted, ko);
    owners_section(b, csrf, db, a.id, admin, ko);
    versions_section(cfg, b, csrf, db, a.id, ko);
    activity_section(b, db, a.id, ko);
    if admin { moderation_section(b, db, ko); }
    page(site, path, title, b.to_str(), 200)
}

/// The versions of the account's packages it may still delete
/// (delete::DELETE_SECS after their publish), each with Delete, which
/// asks again before it deletes.
fn versions_section(cfg: Cfg, b: StrBuf, csrf: str, db: Db, id: i64, ko: bool) {
    let list = delete::deletable(cfg, db, id, now_secs());
    let hours = delete::DELETE_SECS / 3600i64;
    b.push_str(f"<h2 class=\"t-h3\" id=\"versions\">{tr(ko, "Recent versions", "최근 버전")}</h2>\n");
    b.push_str(if ko { f"<p>소유자는 버전을 공개하고 {hours}시간 동안, 다른 패키지가 의존하지 않는 버전을 삭제할 수 있습니다. 삭제한 버전의 줄은 index에서 빠지고, 그 버전 번호는 다시 쓸 수 없습니다. 그 뒤에나 다른 패키지가 의존하게 된 뒤에는 철회하십시오. 그 버전을 고정한 프로젝트는 계속 빌드되고, 새 프로젝트는 건너뜁니다.</p>\n" } else { f"<p>For {hours} hours after its publish, an owner may delete a version that no other package depends on: its line leaves the index and its number is never used again. After that, or once another package depends on it, yank it instead: projects that pinned it keep building, new ones skip it.</p>\n" });
    if list.is_empty() {
        b.push_str(if ko { f"<p>최근 {hours}시간 안에 공개한 내 패키지의 버전이 없습니다.</p>\n" } else { f"<p>No version of your packages was published in the last {hours} hours.</p>\n" });
        return;
    }
    b.push_str(f"<div class=\"table-wrap\"><table class=\"tbl\">\n<thead><tr><th scope=\"col\">{tr(ko, "Package", "패키지")}</th><th scope=\"col\">{tr(ko, "Version", "버전")}</th><th scope=\"col\">{tr(ko, "Published", "공개")}</th><th scope=\"col\">{tr(ko, "Deletable until", "삭제 가능 기한")}</th><th scope=\"col\"><span class=\"sr-only\">{tr(ko, "Delete", "삭제")}</span></th></tr></thead>\n<tbody>\n");
    for v in list {
        b.push_str(f"<tr><td>{esc(v.name)}</td><td class=\"mono\">{esc(v.version)}</td><td>{stamp(v.at)}</td><td>{stamp(v.at + delete::DELETE_SECS)}</td><td>{delete_form(csrf, v.name, v.version, false, tr(ko, "Delete", "삭제"), ko)}</td></tr>\n");
    }
    b.push_str("</tbody>\n</table></div>\n");
}

/// The form that asks to delete `name` `version`; `confirm`: the one
/// that deletes.
fn delete_form(csrf: str, name: str, version: str, confirm: bool, label: str, ko: bool) -> str {
    let yes = if confirm { "<input type=\"hidden\" name=\"confirm\" value=\"yes\">" } else { "" };
    f"<form method=\"post\" action=\"{lp(ko, "/me/versions/delete")}\">{csrf_field(esc(csrf))}<input type=\"hidden\" name=\"package\" value=\"{esc(name)}\"><input type=\"hidden\" name=\"version\" value=\"{esc(version)}\">{yes}<button class=\"{if confirm { "btn" } else { "btn-2" }} btn-sm\" type=\"submit\">{esc(label)}</button></form>"
}

/// The page that asks once more before `name` `version` is deleted.
fn confirm_delete(site: Site, path: str, csrf: str, name: str, version: str) -> Resp {
    let ko = ko_path(path);
    let b = StrBuf::new();
    let title = tr(ko, f"Delete {name} {version}?", f"{name} {version}을(를) 삭제할까요?");
    b.push_str(f"<h1 class=\"t-h1\">{esc(title)}</h1>\n");
    if ko {
        b.push_str(f"<p class=\"t-lead\">그 줄은 index에서 빠지고, 소스 보관본, README, 문서는 레지스트리에서 지워집니다. 되돌릴 수 없고, {esc(version)}은(는) 다시 공개할 수 없습니다. 수정은 새 버전으로 내보냅니다.</p>\n");
        b.push_str("<p>이미 이 버전을 고정한 프로젝트는 더 이상 이 버전을 찾지 못합니다. 그런 프로젝트는 계속 빌드되게 두고 새 프로젝트만 막으려면 철회하십시오.</p>\n");
    } else {
        b.push_str(f"<p class=\"t-lead\">Its line leaves the index, and its source archive, README and docs leave the registry. This cannot be undone, and {esc(version)} cannot be published again: a fix goes out as a new version.</p>\n");
        b.push_str("<p>A project that already locked this version stops resolving it. To keep those building and only stop new ones, yank it instead.</p>\n");
    }
    b.push_str(f"<div class=\"actions\">{delete_form(csrf, name, version, true, tr(ko, f"Delete {name} {version}", f"{name} {version} 삭제"), ko)} <a class=\"btn-2 btn-sm\" href=\"{lp(ko, "/me")}#versions\">{tr(ko, "Cancel", "취소")}</a></div>\n");
    page(site, path, title, b.to_str(), 200)
}

/// `yyyy-mm-dd hh:mm UTC` of a unix time.
pub fn stamp(t: i64) -> str {
    let p2 = |x: i64| if x < 10i64 { f"0{x}" } else { f"{x}" };
    let s = t % 86400i64;
    f"{date(t)} {p2(s / 3600i64)}:{p2((s / 60i64) % 60i64)} UTC"
}

/// The account's sessions, this one first, each with Log out, and Log
/// out everywhere.
fn sessions_section(b: StrBuf, csrf: str, db: Db, cur: Session, ko: bool) {
    let idle = SESSION_IDLE / 86400i64;
    let most = SESSION_SECS / 86400i64;
    b.push_str(if ko { f"<h2 class=\"t-h3\" id=\"sessions\">세션</h2>\n<p>이 계정에 로그인한 브라우저입니다. 세션은 {idle}일 동안 방문이 없으면 끝나고, 늦어도 로그인하고 {most}일 뒤에 끝납니다. 모르는 세션은 로그아웃한 뒤 토큰을 폐기하십시오.</p>\n" } else { f"<h2 class=\"t-h3\" id=\"sessions\">Sessions</h2>\n<p>Each browser logged in to this account. A session ends after {idle} days without a visit, and {most} days after its login at the latest. Log out one you do not know, then revoke your tokens.</p>\n" });
    let mine: List<Session> = [cur];
    for x in db.sessions {
        if x.account == cur.account && x.hash != cur.hash { mine.push(x); }
    }
    let out = tr(ko, "Log out", "로그아웃");
    b.push_str(f"<div class=\"table-wrap\"><table class=\"tbl\">\n<thead><tr><th scope=\"col\">{tr(ko, "Browser", "브라우저")}</th><th scope=\"col\">{tr(ko, "Logged in", "로그인")}</th><th scope=\"col\">{tr(ko, "Last seen", "마지막 방문")}</th><th scope=\"col\">{tr(ko, "Ends", "끝나는 날")}</th><th scope=\"col\"><span class=\"sr-only\">{out}</span></th></tr></thead>\n<tbody>\n");
    for x in mine {
        let what = if x.agent.is_empty() || x.agent == "Unknown browser" { tr(ko, "Unknown browser", "알 수 없는 브라우저") } else { x.agent };
        let here = if x.hash == cur.hash { f" <span class=\"tag\">{tr(ko, "this session", "현재 세션")}</span>" } else { "" };
        let made = if x.created > 0i64 { date(x.created) } else { tr(ko, "unknown", "알 수 없음") };
        b.push_str(f"<tr><td>{esc(what)}{here}</td><td>{made}</td><td>{day(seen_at(x), ko)}</td><td>{day(session_end(x), ko)}</td><td><form method=\"post\" action=\"{lp(ko, f"/me/sessions/{esc(session_id(x))}/logout")}\">{csrf_field(csrf)}<button class=\"btn-2 btn-sm\" type=\"submit\">{out}</button></form></td></tr>\n");
    }
    b.push_str("</tbody>\n</table></div>\n");
    b.push_str(f"<form method=\"post\" action=\"{lp(ko, "/me/sessions/logout-all")}\">{csrf_field(csrf)}<button class=\"btn-2 btn-sm\" type=\"submit\">{tr(ko, "Log out everywhere", "모든 곳에서 로그아웃")}</button></form>\n");
}

/// Where notices go and which kinds the account takes, with the form
/// that changes them.
fn notices_section(cfg: Cfg, b: StrBuf, csrf: str, a: Account, ko: bool) {
    b.push_str(f"<h2 class=\"t-h3\" id=\"notices\">{tr(ko, "Notices by mail", "메일 알림")}</h2>\n");
    if a.email.is_empty() {
        b.push_str(tr(ko, "<p>GitHub gave no verified primary email address for this account, so no notices are sent. Add one in <a href=\"https://github.com/settings/emails\">GitHub's email settings</a>, verify it and make it primary, then log in again.</p>\n", "<p>GitHub가 이 계정의 인증된 기본 메일 주소를 알려 주지 않아 알림을 보내지 않습니다. <a href=\"https://github.com/settings/emails\">GitHub 메일 설정</a>에서 주소를 추가하고 인증한 뒤 기본 주소로 정하고, 다시 로그인하십시오.</p>\n"));
    } else {
        b.push_str(if ko { f"<p>알림은 <strong>{esc(a.email)}</strong>로 보냅니다. 마지막 로그인 때 GitHub에 있던 기본 메일 주소입니다. 다른 주소를 쓰려면 GitHub에서 바꾼 뒤 다시 로그인하십시오.</p>\n" } else { f"<p>Sent to <strong>{esc(a.email)}</strong>, your primary email address on GitHub at your last login. To use another, change it on GitHub and log in again.</p>\n" });
    }
    if !mail::on(cfg) { b.push_str(tr(ko, "<p class=\"t-small muted\">This server sends no mail: its notices are written to its log.</p>\n", "<p class=\"t-small muted\">이 서버는 메일을 보내지 않고, 알림을 로그에 남깁니다.</p>\n")); }
    let boxes = StrBuf::new();
    for (k, what) in mail::kinds() {
        let on = if a.notify_off.contains(k) { "" } else { " checked" };
        boxes.push_str(f"<label><input type=\"checkbox\" name=\"kind-{k}\" value=\"on\"{on}> {esc(kind_text(k, what, ko))}</label> ");
    }
    let all = if a.notify { " checked" } else { "" };
    b.push_str(f"<form method=\"post\" action=\"{lp(ko, "/me/notices")}\">{csrf_field(csrf)}<label><input type=\"checkbox\" name=\"notify\" value=\"on\"{all}> {tr(ko, "Send me notices", "알림 받기")}</label> <fieldset><legend>{tr(ko, "Mail me when", "다음 경우에 메일 받기")}</legend>{boxes.to_str()}</fieldset> <button class=\"btn-2 btn-sm\" type=\"submit\">{tr(ko, "Save", "저장")}</button></form>\n");
}

/// The latest changes to the packages the account owns, by anyone.
fn activity_section(b: StrBuf, db: Db, id: i64, ko: bool) {
    let mine = owned_by(db, id);
    if mine.is_empty() { return; }
    b.push_str(if ko { f"<h2 class=\"t-h3\" id=\"activity\">활동</h2>\n<p>내가 소유한 패키지의 최근 변경 {ACTIVITY}건입니다. 공개, 철회, 소유자, 신뢰할 수 있는 게시자, 토큰의 변경이 들어갑니다. 소유자만 볼 수 있습니다. 나나 공동 소유자가 하지 않은 일이 있으면 토큰을 폐기하고 모르는 세션을 로그아웃하십시오.</p>\n" } else { f"<h2 class=\"t-h3\" id=\"activity\">Activity</h2>\n<p>The latest {ACTIVITY} changes to the packages you own: publishes, yanks, owners, trusted publishers and tokens. Only their owners see this. If one was not you or a co-owner, revoke your tokens and log out the sessions you do not know.</p>\n" });
    let list = events_of(db, mine, ACTIVITY);
    if list.is_empty() {
        b.push_str(tr(ko, "<p>Nothing recorded yet.</p>\n", "<p>아직 기록된 것이 없습니다.</p>\n"));
        return;
    }
    b.push_str(f"<div class=\"table-wrap\"><table class=\"tbl\">\n<thead><tr><th scope=\"col\">{tr(ko, "Package", "패키지")}</th><th scope=\"col\">{tr(ko, "When", "때")}</th><th scope=\"col\">{tr(ko, "Who", "누가")}</th><th scope=\"col\">{tr(ko, "What", "무엇을")}</th></tr></thead>\n<tbody>\n");
    for e in list {
        b.push_str(f"<tr><td>{esc(e.package)}</td><td>{date(e.at)}</td><td>{esc(e.who)}</td><td>{esc(event_text(e, ko))}</td></tr>\n");
    }
    b.push_str("</tbody>\n</table></div>\n");
}

/// Changes the account page shows.
const ACTIVITY: usize = 30;

/// What event `e` did, in words.
pub fn event_text(e: Event, ko: bool = false) -> str {
    let d = e.detail;
    if ko {
        return match e.action {
            "publish" => f"{d} 공개",
            "yank" => f"{d} 철회",
            "unyank" => f"{d} 철회 취소",
            "owner-invite" => f"{d}을(를) 소유자로 초대",
            "owner-add" => f"소유자 {d} 추가",
            "owner-decline" => f"{d}이(가) 초대를 거절",
            "owner-remove" => f"소유자 {d} 제거",
            "trusted-add" => f"신뢰할 수 있는 게시자 {d} 추가",
            "trusted-remove" => f"신뢰할 수 있는 게시자 {d} 제거",
            "token-create" => f"토큰 {d} 만듦",
            "token-revoke" => f"토큰 {d} 폐기",
            "delete" => f"{d} 삭제",
            _ => f"{e.action} {d}".trim(),
        };
    }
    match e.action {
        "publish" => f"published {d}",
        "yank" => f"yanked {d}",
        "unyank" => f"unyanked {d}",
        "owner-invite" => f"invited {d} to own it",
        "owner-add" => f"added owner {d}",
        "owner-decline" => f"{d} declined the invitation",
        "owner-remove" => f"removed owner {d}",
        "trusted-add" => f"added trusted publisher {d}",
        "trusted-remove" => f"removed trusted publisher {d}",
        "token-create" => f"created token {d}",
        "token-revoke" => f"revoked token {d}",
        "advisory-draft" => f"drafted advisory {d}",
        "advisory-edit" => f"edited advisory {d}",
        "advisory-publish" => f"published advisory {d}",
        "advisory-withdraw" => f"withdrew advisory {d}",
        "delete" => f"deleted {d}",
        _ => f"{e.action} {d}".trim(),
    }
}

/// The account's open invitations to own a package, each with Accept and
/// Decline.
fn invites_section(b: StrBuf, csrf: str, db: Db, id: i64, ko: bool) {
    let open = invites_of(db, id);
    if open.is_empty() { return; }
    b.push_str(f"<h2 class=\"t-h3\">{tr(ko, "Invitations", "초대")}</h2>\n<p>{tr(ko, "An owner asked you to share these packages. Accept to publish and yank them and to manage their owners.", "소유자가 이 패키지를 함께 관리하자고 초대했습니다. 수락하면 공개하고 철회하며, 소유자를 관리할 수 있습니다.")}</p>\n<div class=\"table-wrap\"><table class=\"tbl\">\n<thead><tr><th>{tr(ko, "Package", "패키지")}</th><th>{tr(ko, "Invited by", "초대한 사람")}</th><th></th></tr></thead>\n<tbody>\n");
    for v in open {
        let by = account_of(db, v.by) ?? Account { id: v.by, login: "", created: 0i64 };
        let form = |act: str, label: str, cls: str| f"<form method=\"post\" action=\"{lp(ko, "/me/invites/" + act)}\">{csrf_field(csrf)}<input type=\"hidden\" name=\"package\" value=\"{esc(v.name)}\"><button class=\"{cls} btn-sm\" type=\"submit\">{label}</button></form>";
        b.push_str(f"<tr><td>{esc(v.name)}</td><td>{esc(by.login)}</td><td>{form("accept", tr(ko, "Accept", "수락"), "btn")} {form("decline", tr(ko, "Decline", "거절"), "btn-2")}</td></tr>\n");
    }
    b.push_str("</tbody>\n</table></div>\n");
}

/// For an admin: the locked accounts, taken-down packages and approved
/// names on record (changed through the admin API).
fn moderation_section(b: StrBuf, db: Db, ko: bool) {
    let routes = "<code class=\"ic\">/api/v1/admin/lock</code>, <code class=\"ic\">/api/v1/admin/takedown</code>";
    b.push_str(if ko { f"<h2 class=\"t-h3\">관리</h2>\n<p>admin 권한이 있는 토큰으로 {routes}, <code class=\"ic\">/api/v1/admin/approve</code>를 통해 바꿉니다. 모든 변경은 <code class=\"ic\">audit.nabion</code>에 남습니다.</p>\n" } else { f"<h2 class=\"t-h3\">Moderation</h2>\n<p>Changed with an admin token through {routes} and <code class=\"ic\">/api/v1/admin/approve</code>; each change is kept in <code class=\"ic\">audit.nabion</code>.</p>\n" });
    let rows = StrBuf::new();
    for l in db.locked { rows.push_str(f"<tr><td>{tr(ko, "account", "계정")} {l.id}</td><td>{tr(ko, "locked", "잠김")}</td><td>{esc(l.reason)}</td><td>{date(l.at)}</td></tr>\n"); }
    for x in db.removed {
        let what = if x.version.is_empty() { x.name } else { f"{x.name} {x.version}" };
        rows.push_str(f"<tr><td>{esc(what)}</td><td>{tr(ko, "taken down", "게시 중단")}</td><td>{esc(x.reason)}</td><td>{date(x.at)}</td></tr>\n");
    }
    for n in db.approved { rows.push_str(f"<tr><td>{esc(n)}</td><td>{tr(ko, "name approved", "이름 승인")}</td><td></td><td></td></tr>\n"); }
    if rows.is_empty() {
        b.push_str(tr(ko, "<p>Nothing on record.</p>\n", "<p>기록된 것이 없습니다.</p>\n"));
    } else {
        b.push_str(f"<div class=\"table-wrap\"><table class=\"tbl\">\n<thead><tr><th>{tr(ko, "What", "대상")}</th><th>{tr(ko, "Action", "조치")}</th><th>{tr(ko, "Reason", "이유")}</th><th>{tr(ko, "Since", "시작")}</th></tr></thead>\n<tbody>\n{rows.to_str()}</tbody>\n</table></div>\n");
    }
}

/// The owners of the packages the account manages (every package with owners
/// on record, for an admin), a remove button on each, and the add form.
fn owners_section(b: StrBuf, csrf: str, db: Db, id: i64, admin: bool, ko: bool) {
    b.push_str(f"<h2 class=\"t-h3\">{tr(ko, "Owners", "소유자")}</h2>\n");
    b.push_str(tr(ko, "<p>A package's owners publish and yank it and manage its trusted publishers and owners. A user logs in here once before being invited, and owns the package once they accept on their account page. An organization or team (<code class=\"ic\">org/team</code>) is shown on the package's page once one of its repositories is a trusted publisher of it; its members publish through trusted publishing.</p>\n", "<p>패키지의 소유자는 패키지를 공개하고 철회하며, 신뢰할 수 있는 게시자와 소유자를 관리합니다. 사용자는 초대받기 전에 여기에 한 번 로그인해야 하고, 자기 계정 페이지에서 수락하면 소유자가 됩니다. 조직이나 팀(<code class=\"ic\">org/team</code>)은 그 저장소 하나가 패키지의 신뢰할 수 있는 게시자가 되면 패키지 페이지에 보이며, 구성원은 신뢰할 수 있는 게시로 공개합니다.</p>\n"));
    let rows = StrBuf::new();
    let action = lp(ko, "/me/owners/remove");
    for o in db.owners {
        if o.name.starts_with("native/") || !may_manage(db, o.name, id, admin) { continue; }
        let who: List<meta::Person> = List::new();
        for x in o.accounts {
            if let a: Account = account_of(db, x) { who.push(meta::Person { login: a.login, name: a.name, id: a.id }); }
        }
        for g in o.orgs { who.push(meta::Person { login: g.login, id: g.id, org: true }); }
        for p in who {
            // An account is removed by its id: its login may have changed.
            let id_field = if p.org { "" } else { f"<input type=\"hidden\" name=\"id\" value=\"{p.id}\">" };
            rows.push_str(f"<tr><td>{esc(o.name)}</td><td>{layout::person_link(p, 20)}</td><td><form method=\"post\" action=\"{action}\">{csrf_field(csrf)}<input type=\"hidden\" name=\"package\" value=\"{esc(o.name)}\"><input type=\"hidden\" name=\"login\" value=\"{esc(p.login)}\">{id_field}<button class=\"btn-2 btn-sm\" type=\"submit\">{tr(ko, "Remove", "제거")}</button></form></td></tr>\n");
        }
    }
    for v in db.invites {
        if v.package.starts_with("native/") || !may_manage(db, v.package, id, admin) { continue; }
        let u = account_of(db, v.account) ?? Account { id: v.account, login: "", created: 0i64 };
        rows.push_str(f"<tr><td>{esc(v.package)}</td><td>{layout::person_link(meta::Person { login: u.login, name: u.name, id: u.id }, 20)} <span class=\"muted\">{tr(ko, "invited", "초대됨")}</span></td><td><form method=\"post\" action=\"{action}\">{csrf_field(csrf)}<input type=\"hidden\" name=\"package\" value=\"{esc(v.package)}\"><input type=\"hidden\" name=\"login\" value=\"{esc(u.login)}\"><input type=\"hidden\" name=\"id\" value=\"{u.id}\"><button class=\"btn-2 btn-sm\" type=\"submit\">{tr(ko, "Withdraw", "초대 취소")}</button></form></td></tr>\n");
    }
    if rows.is_empty() {
        b.push_str(tr(ko, "<p>No owners on record yet.</p>\n", "<p>아직 기록된 소유자가 없습니다.</p>\n"));
    } else {
        b.push_str(f"<div class=\"table-wrap\"><table class=\"tbl\">\n<thead><tr><th>{tr(ko, "Package", "패키지")}</th><th>{tr(ko, "Owner", "소유자")}</th><th></th></tr></thead>\n<tbody>\n{rows.to_str()}</tbody>\n</table></div>\n");
    }
    b.push_str(f"<form method=\"post\" action=\"{lp(ko, "/me/owners")}\">{csrf_field(csrf)}<label>{tr(ko, "Package", "패키지")} <input name=\"package\" maxlength=\"64\" required></label> <label>{tr(ko, "Owner", "소유자")} <input name=\"login\" placeholder=\"{tr(ko, "login, org or org/team", "로그인, 조직, org/team")}\" maxlength=\"80\" required></label> <button class=\"btn btn-sm\" type=\"submit\">{tr(ko, "Add", "추가")}</button></form>\n");
}

/// The trusted publishers of the packages the account manages, a remove
/// button on each (not on PACKAGES_TRUSTED's), and the form to add one.
fn trusted_section(b: StrBuf, csrf: str, list: List<TrustedPublisher>, ko: bool) {
    b.push_str(f"<h2 class=\"t-h3\">{tr(ko, "Trusted publishers", "신뢰할 수 있는 게시자")}</h2>\n");
    let mins = trust::TOKEN_SECS / 60i64;
    b.push_str(if ko { f"<p>여기에 적은 GitHub Actions 워크플로는 어디에도 토큰을 두지 않고 패키지를 공개합니다. 작업의 OIDC 토큰을 {mins}분 동안 쓰는 토큰으로 바꿉니다. 워크플로는 <a href=\"/ko/publishing#패키지-공개\">패키지 공개</a>에 있습니다.</p>\n" } else { f"<p>A GitHub Actions workflow named here publishes its package with no token kept anywhere: it trades the job's OIDC token for one that lasts {mins} minutes. <a href=\"/publishing#trusted-publishing\">Publishing</a> has the workflow.</p>\n" });
    if list.is_empty() {
        b.push_str(tr(ko, "<p>No trusted publishers yet.</p>\n", "<p>아직 신뢰할 수 있는 게시자가 없습니다.</p>\n"));
    } else {
        b.push_str(f"<div class=\"table-wrap\"><table class=\"tbl\">\n<thead><tr><th>{tr(ko, "Package", "패키지")}</th><th>{tr(ko, "Repository", "저장소")}</th><th>{tr(ko, "Workflow", "워크플로")}</th><th>{tr(ko, "Environment", "환경")}</th><th></th></tr></thead>\n<tbody>\n");
        for p in list {
            let env = if p.environment.is_empty() { f"<span class=\"muted\">{tr(ko, "any", "제한 없음")}</span>" } else { esc(p.environment) };
            let act = if p.seeded { f"<span class=\"muted\">{tr(ko, "server config", "서버 설정")}</span>" } else { f"<form method=\"post\" action=\"{lp(ko, f"/me/trusted/{esc(p.id)}/remove")}\">{csrf_field(csrf)}<button class=\"btn-2 btn-sm\" type=\"submit\">{tr(ko, "Remove", "제거")}</button></form>" };
            b.push_str(f"<tr><td>{esc(p.package)}</td><td>{esc(p.repository)}</td><td>{esc(p.workflow)}</td><td>{env}</td><td>{act}</td></tr>\n");
        }
        b.push_str("</tbody>\n</table></div>\n");
    }
    b.push_str(f"<form method=\"post\" action=\"{lp(ko, "/me/trusted")}\">{csrf_field(csrf)}<label>{tr(ko, "Package", "패키지")} <input name=\"package\" maxlength=\"64\" required></label> <label>{tr(ko, "Repository", "저장소")} <input name=\"repository\" placeholder=\"owner/repo\" maxlength=\"140\" required></label> <label>{tr(ko, "Workflow", "워크플로")} <input name=\"workflow\" placeholder=\"publish.yml\" maxlength=\"255\" required></label> <label>{tr(ko, "Environment", "환경")} <input name=\"environment\" placeholder=\"{tr(ko, "optional", "선택")}\" maxlength=\"255\"></label> <button class=\"btn btn-sm\" type=\"submit\">{tr(ko, "Add", "추가")}</button></form>\n");
}

/// `/me`, `/logout`, `/me/tokens..`, `/me/trusted..`, `/me/owners..` and
/// `/me/invites..` (each also under `/ko`): the session's account pages.
/// The data file is read as it is; each change takes `LOCK` for its own
/// read and write.
pub fn account_route(cfg: Cfg, site: Site, r: Request, client: str) throws -> Resp {
    let ko = ko_path(r.path);
    // The form's path without `/ko`; messages keep `r.path`, which says
    // the language.
    let path = unko(r.path);
    let me = lp(ko, "/me");
    let db = try load_db(cfg);
    let s = session_of(db, r) ?? Session { hash: "", account: 0i64, csrf: "", expires: 0i64 };
    if s.hash.is_empty() {
        return if r.method == "GET" || r.method == "HEAD" { redirect(lp(ko, "/login"), []) } else { message(site, r.path, 401, "Not logged in", "Log in first, then send the form again from the account page.", "로그인하지 않았습니다", "먼저 로그인한 뒤, 계정 페이지에서 양식을 다시 보내십시오.") };
    }
    if r.method == "GET" || r.method == "HEAD" { return me_page(cfg, site, r.path, db, s, ""); }
    if !limit::allow("ip:" + client, 2i64 * cfg.rate) || !limit::allow(f"acct:{s.account}", cfg.rate) {
        let m = message(site, r.path, 429, "Too many changes", "Wait a minute, then send the form again.", "변경이 너무 많습니다", "1분 기다린 뒤 양식을 다시 보내십시오.");
        m.headers.push("Retry-After: 60");
        return m;
    }
    if !r.header("content-type").starts_with("application/x-www-form-urlencoded") {
        return message(site, r.path, 415, "Bad form", "Send the form from the account page.", "잘못된 양식", "계정 페이지에서 양식을 보내십시오.");
    }
    let f = http::form(r.body);
    if !secret::same(f.get("csrf") ?? "", s.csrf) {
        return message(site, r.path, 403, "Bad form", "The form expired; reload the account page.", "잘못된 양식", "양식이 만료되었습니다. 계정 페이지를 새로 고치십시오.");
    }
    if path == "/logout" {
        using g = LOCK.lock() {
            let d = try load_db(cfg);
            let keep: List<Session> = List::new();
            for x in d.sessions {
                if x.hash != s.hash { keep.push(x); }
            }
            d.sessions = keep;
            try save_db(cfg, d);
        }
        audit(cfg, Audit { at: now_secs(), by: s.account, action: "logout", target: session_id(s) });
        return redirect(lp(ko, "/"), [cookie(SESSION_COOKIE, "", 0i64)]);
    }
    // `/me/sessions/<id>/logout` and `/me/sessions/logout-all`.
    if let rest: str = path.strip_prefix("/me/sessions/") {
        let all = rest == "logout-all";
        let which = rest.strip_suffix("/logout") ?? "";
        let found = false;
        let this_one = false;
        using g = LOCK.lock() {
            let d = try load_db(cfg);
            let keep: List<Session> = List::new();
            for x in d.sessions {
                if x.account == s.account && (all || session_id(x) == which) {
                    found = true;
                    if x.hash == s.hash { this_one = true; }
                } else {
                    keep.push(x);
                }
            }
            if found {
                d.sessions = keep;
                try save_db(cfg, d);
            }
        }
        if !found { return message(site, r.path, 404, "No such session", "It has ended already; reload the account page.", "그런 세션이 없습니다", "이미 끝난 세션입니다. 계정 페이지를 새로 고치십시오."); }
        audit(cfg, Audit { at: now_secs(), by: s.account, action: if all { "logout-all" } else { "logout" }, target: if all { "all" } else { which } });
        return if this_one { redirect(lp(ko, "/"), [cookie(SESSION_COOKIE, "", 0i64)]) } else { redirect(me + "#sessions", []) };
    }
    let a = account_of(db, s.account) ?? Account { id: 0i64, login: "", created: 0i64 };
    if path == "/me/notices" {
        let off: List<str> = List::new();
        for (k, _) in mail::kinds() {
            if (f.get("kind-" + k) ?? "") != "on" { off.push(k); }
        }
        let all = (f.get("notify") ?? "") == "on";
        using g = LOCK.lock() {
            let d = try load_db(cfg);
            for i in 0..d.accounts.len() {
                if d.accounts[i].id == a.id {
                    d.accounts[i].notify = all;
                    d.accounts[i].notify_off = off;
                }
            }
            try save_db(cfg, d);
        }
        audit(cfg, Audit { at: now_secs(), by: a.id, action: "notices", target: if all { f"on, off: {off.join(",")}" } else { "off" } });
        return redirect(me + "#notices", []);
    }
    if path == "/me/invites/accept" || path == "/me/invites/decline" {
        let package = (f.get("package") ?? "").trim();
        let yes = path == "/me/invites/accept";
        try accept_invite(cfg, a, package, yes) catch e { return refusal(site, r.path, e.status, "Invitation", "초대", e.msg); };
        return redirect(me, []);
    }
    let admin = is_admin(cfg, a.id);
    if !may_act(cfg, a.id) {
        return message(site, r.path, 403, "Publishing is not open yet", "This account can log in, but cannot create tokens, add trusted publishers or owners, publish or yank yet.", "아직 공개가 열리지 않았습니다", "이 계정은 로그인할 수 있지만, 아직 토큰을 만들거나 신뢰할 수 있는 게시자나 소유자를 추가하거나, 공개하거나 철회할 수 없습니다.");
    }
    if path == "/me/owners" || path == "/me/owners/remove" {
        let package = (f.get("package") ?? "").trim();
        let who = (f.get("login") ?? "").trim();
        if path == "/me/owners" {
            try add_owner(cfg, a, admin, package, who) catch e { return refusal(site, r.path, e.status, "Owner not added", "소유자를 추가하지 못했습니다", e.msg); };
        } else {
            let id = try (f.get("id") ?? "0").trim().parse::<i64>() catch _ { 0i64 };
            try remove_owner(cfg, a, admin, package, who, id) catch e { return refusal(site, r.path, e.status, "Owner not removed", "소유자를 제거하지 못했습니다", e.msg); };
        }
        return redirect(me, []);
    }
    if path == "/me/versions/delete" {
        let package = (f.get("package") ?? "").trim();
        let version = (f.get("version") ?? "").trim();
        if (f.get("confirm") ?? "") != "yes" { return confirm_delete(site, r.path, s.csrf, package, version); }
        try delete::delete_version(cfg, a, admin, package, version, f"{a.login} <{a.id}+{a.login}@users.noreply.github.com>", List::new()) catch e { return refusal(site, r.path, e.status, "Version not deleted", "버전을 삭제하지 못했습니다", e.msg, "삭제할 수 없는 버전입니다. 아래 이유를 확인하고, 필요하면 철회하십시오."); };
        return redirect(me + "#versions", []);
    }
    if path == "/me/trusted" {
        let p = TrustedPublisher { package: (f.get("package") ?? "").trim(), repository: (f.get("repository") ?? "").trim(), workflow: (f.get("workflow") ?? "").trim(), environment: (f.get("environment") ?? "").trim() };
        try add_trusted(cfg, a, admin, p) catch e { return refusal(site, r.path, e.status, "Trusted publisher not added", "신뢰할 수 있는 게시자를 추가하지 못했습니다", e.msg); };
        return redirect(me, []);
    }
    if let rest: str = path.strip_prefix("/me/trusted/") {
        try remove_trusted(cfg, a, admin, rest.strip_suffix("/remove") ?? "") catch e { return refusal(site, r.path, e.status, "Trusted publisher not removed", "신뢰할 수 있는 게시자를 제거하지 못했습니다", e.msg); };
        return redirect(me, []);
    }
    if path == "/me/tokens" {
        let name = (f.get("name") ?? "").trim();
        if name.is_empty() || name.char_count() > 64 {
            return message(site, r.path, 400, "Bad token name", "A token name is 1 to 64 characters.", "잘못된 토큰 이름", "토큰 이름은 1자에서 64자까지입니다.");
        }
        let dt = (f.get("days") ?? "").trim();
        let days = if dt.is_empty() { TOKEN_DAYS } else { try dt.parse::<i64>() catch _ { 0i64 } };
        if days < 1i64 || days > TOKEN_DAYS_MAX {
            return message(site, r.path, 400, "Bad token lifetime", f"A token lasts 1 to {TOKEN_DAYS_MAX} days; write a number of days, such as {TOKEN_DAYS}.", "잘못된 토큰 기간", f"토큰은 1일에서 {TOKEN_DAYS_MAX}일까지 씁니다. {TOKEN_DAYS}처럼 날 수를 적으십시오.");
        }
        let only = token_packages(f.get("packages") ?? "") ?? {
            return message(site, r.path, 400, "Bad package list", "Write package names separated by commas, such as `json, toml`, or leave it empty for all your packages.", "잘못된 패키지 목록", "`json, toml`처럼 패키지 이름을 쉼표로 구분해 적거나, 내 패키지 전부에 쓰려면 비워 두십시오.");
        };
        // The page's form says it lists the scopes; without that (a
        // script, an old page) a token gets the defaults.
        let picked: List<str> = List::new();
        for (name, _) in scopes() {
            if (f.get("scope-" + name) ?? "") == "on" { picked.push(name); }
        }
        if picked.is_empty() && (f.get("scopes") ?? "").is_empty() { picked = default_scopes(); }
        if picked.is_empty() {
            return message(site, r.path, 400, "Nothing chosen", "Tick at least one thing the token may do, such as publishing new versions.", "고른 권한이 없습니다", "새 버전 공개처럼 토큰이 할 일을 하나 이상 체크하십시오.");
        }
        if picked.contains(SCOPE_ADMIN) && !admin {
            return message(site, r.path, 403, "Not an admin", "Only the registry admins give a token the admin scope; untick it.", "관리자가 아닙니다", "admin 권한은 레지스트리 관리자만 토큰에 줄 수 있습니다. 체크를 해제하십시오.");
        }
        if picked.contains(SCOPE_ADMIN) && !only.is_empty() {
            return message(site, r.path, 400, "Admin token limited to packages", "A token limited to some packages cannot moderate; leave Packages empty, or untick the admin scope.", "패키지가 제한된 관리 토큰", "일부 패키지로 제한한 토큰은 관리할 수 없습니다. 패키지를 비워 두거나 admin 권한의 체크를 해제하십시오.");
        }
        let tok = "pkg_" + try secret::random_hex(32);
        let id = try secret::random_hex(8);
        let shown = db;
        using g = LOCK.lock() {
            let d = try load_db(cfg);
            let n = 0usize;
            for t in d.tokens {
                if t.account == a.id { n += 1; }
            }
            if n >= MAX_TOKENS { return message(site, r.path, 400, "Too many tokens", f"Revoke one first (at most {MAX_TOKENS}).", "토큰이 너무 많습니다", f"먼저 하나를 폐기하십시오(최대 {MAX_TOKENS}개)."); }
            let now = now_secs();
            d.tokens.push(Token { id: id, name: name, account: a.id, hash: secret::sha256_hex(tok), created: now, last_used: 0i64, expires: now + days * 86400i64, packages: only, scopes: picked });
            for k in token_keys(d, a.id, only) { record(ref d, Event { package: k, at: now, by: a.id, who: a.login, action: "token-create", detail: f"{name}: {picked.join(", ")}" }); }
            try save_db(cfg, d);
            shown = d;
        }
        audit(cfg, Audit { at: now_secs(), by: a.id, action: "token-create", target: f"{id} {name} {picked.join(",")}" });
        let pk = if only.is_empty() { "all your packages" } else { only.join(", ") };
        mail::notify(cfg, "token", "", "", f"publish token {name} created", f"{a.login} created the publish token \"{name}\".\nIt may: {picked.join(", ")}\nPackages: {pk}\nExpires: {date(now_secs() + days * 86400i64)}", [a.id]);
        return me_page(cfg, site, r.path, shown, s, tok);
    }
    // `/me/tokens/<id>/revoke`
    let id = (path.strip_prefix("/me/tokens/") ?? "").strip_suffix("/revoke") ?? "";
    using g = LOCK.lock() {
        let d = try load_db(cfg);
        let keep: List<Token> = List::new();
        let gone: Token | none = none;
        for t in d.tokens {
            if t.id == id && t.account == a.id { gone = t; } else { keep.push(t); }
        }
        let was = gone ?? { return message(site, r.path, 404, "No such token", "It was revoked already.", "그런 토큰이 없습니다", "이미 폐기한 토큰입니다."); };
        d.tokens = keep;
        for k in token_keys(d, a.id, was.packages) { record(ref d, Event { package: k, at: now_secs(), by: a.id, who: a.login, action: "token-revoke", detail: was.name }); }
        try save_db(cfg, d);
    }
    audit(cfg, Audit { at: now_secs(), by: a.id, action: "token-revoke", target: id });
    redirect(me, [])
}

/// The packages a token of account `id` limited to `only` acts on, whose
/// owners see its creation and revocation: `only`, or all the account's.
fn token_keys(db: Db, id: i64, only: List<str>) -> List<str> { if only.is_empty() { owned_by(db, id) } else { only } }

/// The package names of a token form, as `index::key`s; none when one is
/// not a package name. Empty: every package.
fn token_packages(text: str) -> List<str> | none {
    let out: List<str> = List::new();
    for w in text.replace(" ", ",").split(",") {
        if w.is_empty() { continue; }
        if !pkg::packages::is_name(w.to_lowercase()) { return none; }
        let k = index::key(w);
        if !out.contains(k) { out.push(k); }
    }
    if out.len() > 32 { return none; }
    out
}

#[test]
fn dates() {
    assert(date(0i64) == "never" && date(1700000000i64) == "2023-11-14" && date(951782400i64) == "2000-02-29" && day(0i64, true) == "없음", "dates");
    assert(event_text(Event { package: "geom", at: 0i64, by: 5i64, who: "ann", action: "yank", detail: "0.1.0: broken" }) == "yanked 0.1.0: broken" && event_text(Event { package: "geom", at: 0i64, by: 5i64, who: "ann", action: "new-thing" }) == "new-thing", "events");
    assert(event_text(Event { package: "geom", at: 0i64, by: 5i64, who: "ann", action: "publish", detail: "0.1.0" }, true) == "0.1.0 공개", "korean events");
    assert(scope_text("yank", "yank and unyank versions", true) == "버전 철회와 철회 취소" && scope_text("yank", "yank and unyank versions", false) == "yank and unyank versions", "scopes");
    assert((token_packages("") ?? ["x"]).is_empty() && (token_packages("json, Nabi-Syntax,json") ?? List::new()).join(" ") == "json nabi_syntax" && token_packages("a b/c") is none, "token packages");
}
