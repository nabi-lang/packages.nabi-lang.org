// The JSON GitHub answers with (OAuth, /user, /repos, OIDC discovery,
// JWKS, OIDC token claims): members of an object and elements of an
// array, as text. Not a validating parser. And the JSON the public API
// answers with when asked: a NABION value written as JSON (write);
// `quote` also writes the requests to Amazon SES.

use std::nabion::Value;

fn chars(s: str) -> List<char> {
    let cs: List<char> = List::new();
    for c in s.chars() { cs.push(c); }
    cs
}

fn ws(cs: List<char>, k: usize) -> usize {
    let j = k;
    while j < cs.len() && (cs[j] == ' ' || cs[j] == '\n' || cs[j] == '\r' || cs[j] == '\t') { j += 1; }
    j
}

/// The string whose quote is at `k`: its text, and the index past it.
fn read_str(cs: List<char>, k: usize) -> (str, usize) {
    let n = cs.len();
    let b = StrBuf::new();
    let j = k + 1;
    while j < n && cs[j] != '"' {
        if cs[j] == '\\' && j + 1 < n {
            j += 1;
            let e = cs[j];
            if e == 'n' { b.push('\n'); } else if e == 't' { b.push('\t'); } else if e == 'r' { b.push('\r'); } else if e == 'b' || e == 'f' { b.push(' '); } else if e == 'u' && j + 4 < n {
                let code = 0u32;
                for q in 1usize..5usize { code = code * 16u32 + (cs[j + q].to_digit(16u32) ?? 0u32); }
                b.push(char::from_u32(code) ?? '\u{fffd}');
                j += 4;
            } else { b.push(e); }
        } else {
            b.push(cs[j]);
        }
        j += 1;
    }
    (b.to_str(), j + 1)
}

/// The index past the value at `k`.
fn skip(cs: List<char>, k: usize) -> usize {
    let n = cs.len();
    let i = k;
    if i >= n { return n; }
    if cs[i] == '"' { return read_str(cs, i).1; }
    if cs[i] == '{' || cs[i] == '[' {
        let depth = 0;
        while i < n {
            let c = cs[i];
            if c == '"' {
                i = read_str(cs, i).1;
                continue;
            }
            if c == '{' || c == '[' { depth += 1; }
            if c == '}' || c == ']' { depth -= 1; }
            i += 1;
            if depth == 0 { break; }
        }
        return i;
    }
    while i < n && cs[i] != ',' && cs[i] != '}' && cs[i] != ']' && cs[i] != ' ' && cs[i] != '\n' && cs[i] != '\r' && cs[i] != '\t' { i += 1; }
    i
}

fn text(cs: List<char>, a: usize, b: usize) -> str {
    let t = StrBuf::new();
    for i in a..b { t.push(cs[i]); }
    t.to_str()
}

/// Each member of the object `s` in order: its key, its value as text
/// (a string decoded, anything else as written) and whether it is a
/// string. Empty when `s` is not an object.
pub fn members(s: str) -> List<(str, str, bool)> {
    let out: List<(str, str, bool)> = List::new();
    let cs = chars(s);
    let n = cs.len();
    let i = ws(cs, 0usize);
    if i >= n || cs[i] != '{' { return out; }
    i += 1;
    while i < n {
        i = ws(cs, i);
        if i >= n || cs[i] != '"' { break; }
        let (k, after) = read_str(cs, i);
        i = ws(cs, after);
        if i >= n || cs[i] != ':' { break; }
        i = ws(cs, i + 1);
        if i >= n { break; }
        if cs[i] == '"' {
            let (v, a2) = read_str(cs, i);
            out.push((k, v, true));
            i = a2;
        } else {
            let end = skip(cs, i);
            out.push((k, text(cs, i, end), false));
            i = end;
        }
        i = ws(cs, i);
        if i < n && cs[i] == ',' { i += 1; }
    }
    out
}

/// Top-level scalar members of an object, as text (strings decoded;
/// numbers, `true`, `false`, `null` as written). Nested values skipped.
pub fn fields(s: str) -> Dict<str, str> {
    let out: Dict<str, str> = Dict::new();
    for (k, v, quoted) in members(s) {
        if quoted || !(v.starts_with("{") || v.starts_with("[")) { out.insert(k, v); }
    }
    out
}

/// The text of member `key` of the object `s` (an object or array as
/// written), or none.
pub fn member(s: str, key: str) -> str | none {
    let found: str | none = none;
    for (k, v, _) in members(s) {
        if k == key { found = v; }
    }
    found
}

/// Each element of the array `s`, as written.
pub fn items(s: str) -> List<str> {
    let out: List<str> = List::new();
    let cs = chars(s);
    let n = cs.len();
    let i = ws(cs, 0usize);
    if i >= n || cs[i] != '[' { return out; }
    i += 1;
    while i < n {
        i = ws(cs, i);
        if i >= n || cs[i] == ']' { break; }
        let end = skip(cs, i);
        if end == i { break; }
        out.push(text(cs, i, end));
        i = ws(cs, end);
        if i < n && cs[i] == ',' { i += 1; }
    }
    out
}

/// `s` as a JSON string: quotes, backslashes and control characters
/// escaped, nothing lost.
pub fn quote(s: str) -> str {
    let out = StrBuf::new();
    out.push('"');
    for c in s.chars() {
        match c {
            '"' => out.push_str("\\\""),
            '\\' => out.push_str("\\\\"),
            '\n' => out.push_str("\\n"),
            '\r' => out.push_str("\\r"),
            '\t' => out.push_str("\\t"),
            x => {
                let u = x as u32;
                if u < 0x20u32 || u == 0x2028u32 || u == 0x2029u32 {
                    let h = "0123456789abcdef";
                    out.push_str("\\u");
                    for sh in [12u32, 8u32, 4u32, 0u32] {
                        let k = ((u >> sh) & 15u32) as usize;
                        out.push_str(h[k:k + 1]);
                    }
                } else {
                    out.push(x);
                }
            },
        }
    }
    out.push('"');
    out.to_str()
}

/// `v` as JSON on one line. A struct is an object (its name dropped), a
/// tuple an array, `none` null, a char a string; a dict's keys that are
/// not strings are written as NABION. A variant without data is its
/// path as a string, one with data an object of one member, the path,
/// holding its fields (or its one value, or its values as an array).
pub fn write(v: Value) -> str {
    match v {
        Value::None => "null",
        Value::Bool(b) => if b { "true" } else { "false" },
        Value::Int(i) => f"{i}",
        Value::Float(x) => f"{x}",
        Value::Char(c) => quote(f"{c}"),
        Value::Str(s) => quote(s),
        Value::List(xs) => array(xs),
        Value::Tuple(xs) => array(xs),
        Value::Dict(d) => {
            let parts: List<str> = List::new();
            for (k, x) in d.iter() {
                let key = if let Value::Str(t) = k { t } else { (try? std::nabion::to_str_flat(k)) ?? "" };
                parts.push(quote(key) + ":" + write(x));
            }
            "{" + parts.join(",") + "}"
        },
        Value::Struct { name: _, fields } => object(fields),
        Value::Variant { path, args, named } => {
            if args.is_empty() && named.is_empty() { return quote(path); }
            let inner = if !named.is_empty() { object(named) } else if args.len() == 1 { write(args[0]) } else { array(args) };
            "{" + quote(path) + ":" + inner + "}"
        },
        _ => "null",
    }
}

fn array(xs: List<Value>) -> str {
    let parts: List<str> = List::new();
    for x in xs { parts.push(write(x)); }
    "[" + parts.join(",") + "]"
}

fn object(fields: Dict<str, Value>) -> str {
    let parts: List<str> = List::new();
    for (k, x) in fields.iter() { parts.push(quote(k) + ":" + write(x)); }
    "{" + parts.join(",") + "}"
}

#[cfg(test)]
fn expect(ok: bool, what: str) {
    if !ok { panic(what); }
}

#[test]
fn github_json() {
    let f = fields("{\"login\": \"octo-cat\", \"id\": 583231, \"plan\": {\"name\": \"x\", \"a\": [1, \"]\"]}, \"bio\": \"a \\\"q\\\" \\u00e9\", \"site_admin\": false}");
    expect(f["login"] == "octo-cat" && f["id"] == "583231" && f["site_admin"] == "false" && f["bio"] == "a \"q\" é" && !f.contains_key("plan"), "fields");
    expect(fields("{\"error\":\"bad_verification_code\"}")["error"] == "bad_verification_code", "compact");
    expect(fields("[1]").len() == 0, "not an object");
    let repo = "{\"id\": 9, \"full_name\": \"o/r\", \"owner\": {\"login\": \"o\", \"id\": 42, \"x\": [\"}\"]}, \"private\": false}";
    let owner = member(repo, "owner") ?? "";
    expect(fields(owner)["id"] == "42" && fields(repo)["full_name"] == "o/r" && member(repo, "nope") is none, owner);
    let keys = items(member("{\"keys\":[{\"kid\":\"a\"},{\"kid\":\"b,]\"}]}", "keys") ?? "");
    expect(keys.len() == 2 && fields(keys[1])["kid"] == "b,]", f"{keys:?}");
    expect(items("[]").len() == 0 && items("[1, \"x\" ,true]").len() == 3 && items("{}").len() == 0, "items");
    let q = quote("a\"b\\c\nd\u{1}é");
    expect(q == "\"a\\\"b\\\\c\\nd\\u0001é\"", q);
    expect(fields(f"{{\"k\": {quote("x\"\n\ty")}}}")["k"] == "x\"\n\ty", "round trip");
}

#[test]
fn writing() {
    let v = try std::nabion::parse("Package { name: \"a\\\"b\", n: 3, x: 1.5, ok: true, gone: none, vs: [Version { v: \"1\" }], t: (1, 'c'), d: { \"k\": 1 }, s: Dep::path(\"../x\"), u: Kind::Fn, w: Dep::git(\"u\", rev: \"r\") }") catch e { panic(f"{e}"); };
    let j = write(v);
    expect(j == "{\"name\":\"a\\\"b\",\"n\":3,\"x\":1.5,\"ok\":true,\"gone\":null,\"vs\":[{\"v\":\"1\"}],\"t\":[1,\"c\"],\"d\":{\"k\":1},\"s\":{\"Dep::path\":\"../x\"},\"u\":\"Kind::Fn\",\"w\":{\"Dep::git\":{\"rev\":\"r\"}}}", j);
    expect(quote("tab\there\u{1}\u{2028}") == "\"tab\\there\\u0001\\u2028\"", quote("tab\there\u{1}"));
}
