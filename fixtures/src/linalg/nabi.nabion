Package {
    name: "linalg",
    version: "0.1.0",
    nabi_version: "0.1.0",
    toolchain: "0.1",
    description: "Dense linear algebra on core arrays: products, LU, Cholesky, QR, SVD, eigen, Schur, solvers, expm",
    license: "MIT OR Apache-2.0",
    repository: "https://github.com/nabi-lang/linalg",
    keywords: ["linear-algebra", "matrix", "svd", "eigenvalues", "numerics"],
    categories: ["mathematics", "science"],
    deps: {},
    features: {
        "default": ["ops"],
        "ops": [],
    },
}
