Package {
    name: "interpolate",
    version: "0.1.0",
    nabi_version: "0.1.0",
    toolchain: "0.1",
    description: "Interpolation, splines, smoothing and quadrature on core arrays: 1-d and gridded N-d interpolants, B-splines, Delaunay, k-d trees, RBF, polynomials, integration",
    license: "MIT OR Apache-2.0",
    repository: "https://github.com/nabi-lang/interpolate",
    keywords: ["interpolation", "spline", "quadrature", "delaunay", "numerics"],
    categories: ["mathematics", "science"],
    deps: {
        "autodiff": Dep::path("../autodiff", version: "^0.1"),
        "linalg": Dep::path("../linalg", version: "^0.1"),
    },
    features: {
        "default": ["ops"],
        "ops": [],
    },
}
