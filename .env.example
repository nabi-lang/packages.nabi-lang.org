# Settings for `nabi run -- serve`. Copy to `.env` (git-ignored); variables
# already in the process environment win over this file.

# Public base URL: OAuth callback ({URL}/auth/github/callback) and links.
PACKAGES_URL=https://packages.nabi-lang.org
# Plain HTTP listen address; TLS ends at the reverse proxy.
PACKAGES_ADDR=127.0.0.1:8080

# GitHub OAuth app (Settings > Developer settings > OAuth Apps).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Numeric GitHub user ids that may publish and moderate (comma-separated):
# the `id` of https://api.github.com/users/<login>. Logins are refused.
PACKAGES_ADMINS=

# Accounts, sessions, tokens and owners (db.nabion).
PACKAGES_DATA=/var/lib/packages/data
# Index checkout the server commits to and pushes from (with its own git
# credentials); it must track an upstream branch.
PACKAGES_INDEX=/var/lib/packages/packages-index

# The header a trusted proxy puts the client address in, for rate limits.
# PACKAGES_CLIENT_HEADER=cf-connecting-ip
# Changes an account may make a minute (an address: twice that).
# PACKAGES_RATE_LIMIT=30

# GitHub's numeric id of the nabi-lang organization (the `id` of
# https://api.github.com/orgs/nabi-lang): versions its repositories
# publish through trusted publishing are official. Unset: none are.
# PACKAGES_OFFICIAL_ORG=

# Trusted publishers to seed at start (a NABION list); optional.
# PACKAGES_TRUSTED=/srv/packages/trusted.nabion
# The `aud` of GitHub Actions OIDC tokens; default: PACKAGES_URL's host.
# PACKAGES_AUDIENCE=packages.nabi-lang.org

# Only for tests against a fake GitHub.
# GITHUB_OAUTH_URL=https://github.com
# GITHUB_API_URL=https://api.github.com
# GITHUB_OIDC_ISSUER=https://token.actions.githubusercontent.com
